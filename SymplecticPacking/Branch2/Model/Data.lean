import SymplecticPacking.Qhat.Main

/-!
# The data consumed by the cubic model

`CubicData` collects the quantities on which the handle, strip, layer and return constructions
of the four-dimensional construction depend (the constructions are in `Branch2/Model/Cubic/`):
`h`, `dn`, `g`, `eh`, `Hstar`, `K`, `J`, `F`, `muh`, `hi`, `rhoBar`, …. The per-ball quantities
take the ball index `i : ℕ` (`1 ≤ i ≤ k`): `a i`, `rho i`, `hi i`, `rhoBar i`, `deltaStrip i`,
`rhoHat i`, and the comparison isotopy `qhat` is generated by the field `path`
(`Qhat.qhat D.path`). `Valid` collects the hypotheses on the data, among them the comparison
estimate `comparison`; the estimates `Hstar_ge`, `hi_gt_pos_part`, `hi_sub_pos_part_le`,
`sum_hi_le`, `residual_ge`, `rho_lt_rhoBar`, `rhoBar_lt_rhoHat` follow from it.

The equal-ball parameters `P : Params` give a valid `CubicData` (`ofParams`, `ofParams_valid`;
linear `K`, `prop:cmp-linear`); the unequal construction gives `Branch2.cubicDataOf`
(`Model/Unequal.lean`).
-/

noncomputable section

namespace SymplecticPacking.Branch2

open Set
open scoped Real ContDiff

/-- Parameters of the cubic model (normalised target capacity `1`). Ball indices are `1 … k`. -/
structure CubicData where
  /-- number of balls -/
  k : ℕ
  /-- requested (normalised) capacities `ρ_i` -/
  rho : ℕ → ℝ
  /-- auxiliary capacities `a_i > ρ_i` -/
  a : ℕ → ℝ
  /-- fibre height -/
  h : ℝ
  /-- radius of the transfer domain, `h < d_n < 1/3` -/
  dn : ℝ
  /-- gap scale (`g = 3ε/8` in the equal case) -/
  g : ℝ
  /-- comparison function -/
  K : ℝ → ℝ
  /-- the five-segment path generating the comparison isotopy `q̂_t` -/
  path : Qhat.PathData

namespace CubicData

variable (D : CubicData)

/-- `H_b(p) = 3(1 - 3p)`. -/
def Hb (p : ℝ) : ℝ := 3 * (1 - 3 * p)

/-- `P_b(p) = H_b(p) - Σ_{i=1}^k (a_i - p)_+`. -/
def Pb (p : ℝ) : ℝ := Hb p - ∑ i ∈ Finset.Icc 1 D.k, max (D.a i - p) 0

/-- `F = K - P_b`. -/
def F (p : ℝ) : ℝ := D.K p - D.Pb p

/-- `e_h = g/16`. -/
def eh : ℝ := D.g / 16

/-- `H*(p) = H_b(p) - e_h`. -/
def Hstar (p : ℝ) : ℝ := Hb p - D.eh

/-- `μ_h = g/(16k)`. -/
def muh : ℝ := D.g / (16 * D.k)

/-- Smoothed caps `h_i(p) = [a_i - p + √((a_i - p)² + μ_h²)]/2`. -/
def hi (i : ℕ) (p : ℝ) : ℝ := (D.a i - p + Real.sqrt ((D.a i - p) ^ 2 + D.muh ^ 2)) / 2

/-- `J = K - H*`. -/
def J (p : ℝ) : ℝ := D.K p - D.Hstar p

/-- `ρ̄_i = (ρ_i + a_i)/2`. -/
def rhoBar (i : ℕ) : ℝ := (D.rho i + D.a i) / 2

/-- `δ_i = a_i - ρ̄_i` (strip slack of ball `i`). -/
def deltaStrip (i : ℕ) : ℝ := D.a i - D.rhoBar i

/-- `ρ̂_i = ρ̄_i + δ_i/4`. -/
def rhoHat (i : ℕ) : ℝ := D.rhoBar i + D.deltaStrip i / 4

/-- The comparison isotopy `q̂_t` and its inverse. -/
def qhat : ℝ → ℂ → ℂ := Qhat.qhat D.path

/-- Validity of the data (everything the model stage uses). -/
structure Valid : Prop where
  one_le_k : 1 ≤ D.k
  rho_pos : ∀ i, 1 ≤ i → i ≤ D.k → 0 < D.rho i
  rho_lt_a : ∀ i, 1 ≤ i → i ≤ D.k → D.rho i < D.a i
  a_lt_h : ∀ i, 1 ≤ i → i ≤ D.k → D.a i < D.h
  h_pos : 0 < D.h
  h_lt_dn : D.h < D.dn
  dn_lt_third : D.dn < 1 / 3
  g_pos : 0 < D.g
  g_le : D.g ≤ 3 * (1 - 3 * D.h)
  K_smooth : ContDiff ℝ ∞ D.K
  path_ok : Qhat.OrdinaryPath D.path
  path_h : D.path.h = D.h
  /-- `eq:shd4-comparison`: `K(π|z|²) - F(π|q̂₁ z|²) ≥ 31g/32` on `D̄(h)`. -/
  comparison : ∀ z : ℂ, π * ‖z‖ ^ 2 ≤ D.h →
    31 * D.g / 32 ≤ D.K (π * ‖z‖ ^ 2) - D.F (π * ‖D.qhat 1 z‖ ^ 2)

variable {D}

namespace Valid

variable (hD : D.Valid)
include hD

lemma h_lt_third : D.h < 1 / 3 := hD.h_lt_dn.trans hD.dn_lt_third

lemma k_pos : (0 : ℝ) < D.k := by have := hD.one_le_k; exact_mod_cast (by omega : 0 < D.k)

lemma muh_pos : 0 < D.muh := div_pos hD.g_pos (by linarith [hD.k_pos])

/-- `H* ≥ 15g/16` on `p ≤ h`. -/
lemma Hstar_ge {p : ℝ} (hp : p ≤ D.h) : 15 * D.g / 16 ≤ D.Hstar p := by
  have := hD.g_le
  unfold Hstar Hb eh; linarith

lemma hi_gt_pos_part (i : ℕ) (p : ℝ) : max (D.a i - p) 0 < D.hi i p := by
  have hm := hD.muh_pos
  have hs : |D.a i - p| < Real.sqrt ((D.a i - p) ^ 2 + D.muh ^ 2) := by
    rw [← Real.sqrt_sq_eq_abs]
    exact Real.sqrt_lt_sqrt (sq_nonneg _) (by nlinarith)
  unfold hi
  rcases le_total (D.a i - p) 0 with h | h
  · rw [max_eq_right h]; have := abs_of_nonpos h; linarith
  · rw [max_eq_left h]; have := abs_of_nonneg h; linarith

lemma hi_sub_pos_part_le (i : ℕ) (p : ℝ) : D.hi i p - max (D.a i - p) 0 ≤ D.muh / 2 := by
  have hm := hD.muh_pos
  have hs : Real.sqrt ((D.a i - p) ^ 2 + D.muh ^ 2) ≤ |D.a i - p| + D.muh := by
    rw [Real.sqrt_le_left (by positivity)]
    nlinarith [abs_nonneg (D.a i - p), sq_abs (D.a i - p)]
  unfold hi
  rcases le_total (D.a i - p) 0 with h | h
  · rw [max_eq_right h, abs_of_nonpos h] at *; linarith
  · rw [max_eq_left h, abs_of_nonneg h] at *; linarith

/-- `Σ h_i ≤ Σ (a_i - p)_+ + g/32`. -/
lemma sum_hi_le (p : ℝ) :
    ∑ i ∈ Finset.Icc 1 D.k, D.hi i p ≤ ∑ i ∈ Finset.Icc 1 D.k, max (D.a i - p) 0 + D.g / 32 := by
  have hk := hD.k_pos
  have h1 : ∑ i ∈ Finset.Icc 1 D.k, D.hi i p ≤
      ∑ i ∈ Finset.Icc 1 D.k, (max (D.a i - p) 0 + D.muh / 2) :=
    Finset.sum_le_sum fun i _ => by linarith [hD.hi_sub_pos_part_le i p]
  rw [Finset.sum_add_distrib, Finset.sum_const, Nat.card_Icc, Nat.add_sub_cancel,
    nsmul_eq_mul] at h1
  have h2 : (D.k : ℝ) * (D.muh / 2) = D.g / 32 := by
    unfold muh; field_simp; ring
  linarith

/-- **Margin** (`residual_ge`): if `K(I) - F(p') ≥ 31g/32`, then
`K(I) - J(p') - Σ h_i(p') ≥ 7g/8`. -/
theorem residual_ge {I p' : ℝ} (h1 : 31 * D.g / 32 ≤ D.K I - D.F p') :
    7 * D.g / 8 ≤ D.K I - D.J p' - ∑ i ∈ Finset.Icc 1 D.k, D.hi i p' := by
  have := hD.sum_hi_le p'
  unfold F Pb at h1
  unfold J Hstar eh
  linarith

lemma rho_lt_rhoBar {i : ℕ} (h1 : 1 ≤ i) (hk : i ≤ D.k) : D.rho i < D.rhoBar i := by
  have := hD.rho_lt_a i h1 hk; unfold rhoBar; linarith

lemma deltaStrip_pos {i : ℕ} (h1 : 1 ≤ i) (hk : i ≤ D.k) : 0 < D.deltaStrip i := by
  have := hD.rho_lt_a i h1 hk; unfold deltaStrip rhoBar; linarith

lemma rhoBar_lt_rhoHat {i : ℕ} (h1 : 1 ≤ i) (hk : i ≤ D.k) : D.rhoBar i < D.rhoHat i := by
  have := hD.deltaStrip_pos h1 hk; unfold rhoHat; linarith

end Valid

/-! ### The equal-ball instance -/

/-- The equal-ball parameters as `CubicData` (linear `K`, the five-segment path of `sec:pln`). -/
def ofParams (P : Params) : CubicData where
  k := P.k
  rho := fun _ => P.rho
  a := fun _ => P.a
  h := P.h
  dn := P.dn
  g := P.g
  K := P.K
  path := Qhat.pathData P

lemma ofParams_F (P : Params) (p : ℝ) : (ofParams P).F p = P.F p := by
  simp only [F, Pb, Hb, ofParams, Params.F, Params.Pb, Params.Hb, Params.K, Finset.sum_const,
    Nat.card_Icc, Nat.add_sub_cancel, nsmul_eq_mul]

theorem ofParams_valid (P : Params) : (ofParams P).Valid where
  one_le_k := by have := P.hk; show 1 ≤ P.k; omega
  rho_pos := fun _ _ _ => P.rho_pos
  rho_lt_a := fun _ _ _ => P.rho_lt_a
  a_lt_h := fun _ _ _ => P.a_lt_h
  h_pos := P.h_pos
  h_lt_dn := P.h_lt_dn
  dn_lt_third := P.dn_lt_third
  g_pos := P.g_pos
  g_le := by
    show P.g ≤ 3 * (1 - 3 * P.h)
    unfold Params.g Params.h Params.t0; linarith
  K_smooth := contDiff_const.mul contDiff_id
  path_ok := Qhat.ordinaryPath P
  path_h := rfl
  comparison := fun z hz => by
    rw [ofParams_F]
    exact Qhat.full_comparison P hz

end CubicData

end SymplecticPacking.Branch2
