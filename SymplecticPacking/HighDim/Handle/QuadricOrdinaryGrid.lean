import SymplecticPacking.HighDim.Handle.QuadricRationalValidation

/-!
# The ordinary grid boxes of the quadric

The finite ordinary-coordinate box family generated by exact rational tests.
-/

noncomputable section
namespace SymplecticPacking.HighDim.ToricPackingStages
open Set Function
open OAI.PackingSufficiencySupport.DiagonalQuadrics

abbrev OrdinaryGridIndex {m : ℕ} (a : Fin m → ℚ) (R r η : ℚ) (N : ℕ) (h : ℚ) :=
  {i : Fin (2*N+1) × Fin (2*N+1) // rationalOrdinaryValid a R r η (rationalGridPoint N h i)} ×
    (Fin m → Bool)

/-- The index type is a genuinely finite computable filter of a predetermined grid. -/
instance {m : ℕ} (a : Fin m → ℚ) (R r η : ℚ) (N : ℕ) (h : ℚ) :
    Fintype (OrdinaryGridIndex a R r η N h) := inferInstance

def ordinaryGridBox {m : ℕ} (a : Fin m → ℚ) {R r η : ℚ} (hR : 0 ≤ R)
    {N : ℕ} {h : ℚ} (i : OrdinaryGridIndex a R r η N h) :
    RawCoordinateBox (locus (fun j => (a j:ℂ))) :=
  let q := rationalGridPoint N h i.1.val
  let c := ordinaryPresentationCenter (fun j => (a j:ℂ)) i.2 (rationalComplex q)
  let hvalid := (rationalOrdinaryValid_sound a hR q i.1.property i.2).1
  ordinaryRawBox c (QuadricBoxCode.ordinary_margin_regular _ hvalid.1 hvalid.2)
    r hvalid.1 hvalid.2

theorem ordinaryGridBox_smooth {m : ℕ} (a : Fin m → ℚ)
    [Fact (Injective (fun j => (a j:ℂ)))] [Fact (∀ j, (a j:ℂ) ≠ 0)]
    {R r η : ℚ} (hR : 0 ≤ R) {N : ℕ} {h : ℚ}
    (i : OrdinaryGridIndex a R r η N h) : (ordinaryGridBox a hR i).Smooth := by
  let q := rationalGridPoint N h i.1.val
  have hv := (rationalOrdinaryValid_sound a hR q i.1.property i.2).1
  exact ordinaryRawBox_smooth (ordinaryPresentationCenter (fun j => (a j:ℂ)) i.2 (rationalComplex q))
    (QuadricBoxCode.ordinary_margin_regular _ hv.1 hv.2) r hv.1 hv.2

theorem ordinaryGridBox_inside {m : ℕ} (a : Fin m → ℚ) {R r η : ℚ} (hR : 0 ≤ R)
    {N : ℕ} {h : ℚ} (i : OrdinaryGridIndex a R r η N h) :
    (ordinaryGridBox a hR i).compactCarrier ⊆
      interior (projectionDomain (fun j => (a j:ℂ)) ((R:ℝ)+1)) := by
  let q := rationalGridPoint N h i.1.val
  have hv := rationalOrdinaryValid_sound a hR q i.1.property i.2
  exact ordinaryRawBox_inside (ordinaryPresentationCenter (fun j => (a j:ℂ)) i.2 (rationalComplex q))
    (QuadricBoxCode.ordinary_margin_regular _ hv.1.1 hv.1.2) r hv.1.1 hv.1.2 hv.2

#check_explicit ordinaryGridBox
end SymplecticPacking.HighDim.ToricPackingStages
