import SymplecticPacking.HighDim.Model
import OAI.Geometry.BallPacking.Hamiltonian.AnnularDensityMass

/-!
# Explicit ingredients of the split layer form (paper thm:mech-packing, handle map `𝒟`)

The split form at the end of the handle map is the OpenAI library's second-path form
`globalHorizontalCoupling phaseArea (globalSurfaceSecondPrimitive …)` evaluated at time one,
with the following explicit ingredients, each in place of an existential witness of the
library:

* `layerClock`: explicit flat clocks on `k + 1` ordered disjoint subintervals of `(−b, b)`
  (one per ball and one residual), in place of `exists_surface_layer_clocks`;
  `layerClocks_spec`, `layerClocks_final` give all the properties the library uses;
* `smoothCap`: the explicit smoothing `x · smoothTransition(x / c)` of the cap profile
  `(a_i − |p|)_+`, squeezed between `ρ̄_i − |p|` (`ρ̄_i = (a_i + r_i)/2 > r_i`) and
  `(a_i − |p|)_+`;
* `comparatorIsotopy`: the compactly supported Hamiltonian isotopy generated by a comparator
  generator `Q` (the flow `isoOf Q`, packaged as the library's `CompactHamiltonianIsotopy`;
  time-one map `= D.qMap`), and `fibreIsotopy D` for a comparison datum;
* `layerFormOf`: the split form for given isotopy, comparator `K`, handle mass `H` and normalized
  primitive `Γ`.

Model-specific normalization and handle mass are supplied by the native raw construction.
-/

noncomputable section

namespace SymplecticPacking.HighDim

open Set Manifold
open OAI.PackingSufficiencySupport.Hamiltonian
open OAI.PackingSufficiencySupport.MomentPolytope (Moments region planeRegion)
open scoped ContDiff Manifold

namespace ToricPackingStages

/-! ### Explicit layer clocks -/

/-- Step length of the subdivision of `(a, b)` into `3N + 1` equal pieces. -/
def layerStep (N : ℕ) (a b : ℝ) : ℝ := (b - a) / (3 * (N : ℝ) + 1)

/-- Left end of the `i`-th layer interval. -/
def layerLo (N : ℕ) (a b : ℝ) (i : Fin N) : ℝ := a + layerStep N a b * (3 * (i.val : ℝ) + 1)

/-- Right end of the `i`-th layer interval. -/
def layerHi (N : ℕ) (a b : ℝ) (i : Fin N) : ℝ := a + layerStep N a b * (3 * (i.val : ℝ) + 2)

/-- The `i`-th layer clock: `0` left of `lo_i + D/4`, `1` right of `hi_i − D/4`. -/
def layerClock (N : ℕ) (a b : ℝ) (i : Fin N) : ℝ → ℝ :=
  intervalClock (layerLo N a b i + layerStep N a b / 4) (layerHi N a b i - layerStep N a b / 4)

theorem layerStep_pos (N : ℕ) {a b : ℝ} (hab : a < b) : 0 < layerStep N a b :=
  div_pos (sub_pos.mpr hab) (by positivity)

theorem layerStep_mul (N : ℕ) {a b : ℝ} : layerStep N a b * (3 * (N : ℝ) + 1) = b - a := by
  have hden : (3 * (N : ℝ) + 1) ≠ 0 := by positivity
  unfold layerStep; field_simp

theorem layerClock_between (N : ℕ) {a b : ℝ} (hab : a < b) (i : Fin N) :
    layerLo N a b i + layerStep N a b / 4 < layerHi N a b i - layerStep N a b / 4 := by
  have hD := layerStep_pos N hab
  unfold layerLo layerHi; nlinarith

/-- The explicit clocks have every property of the library's `exists_ordered_smooth_clocks`. -/
theorem layerClocks_spec (N : ℕ) {a b : ℝ} (hab : a < b) :
    (∀ i, a < layerLo N a b i ∧ layerLo N a b i < layerHi N a b i ∧ layerHi N a b i < b) ∧
    (∀ i j, i < j → layerHi N a b i < layerLo N a b j) ∧
    (∀ i, ContDiff ℝ ∞ (layerClock N a b i) ∧ Monotone (layerClock N a b i)) ∧
    (∀ i s, 0 ≤ layerClock N a b i s ∧ layerClock N a b i s ≤ 1 ∧
      0 ≤ deriv (layerClock N a b i) s) ∧
    (∀ i, ∃ δ : ℝ, 0 < δ ∧
      (∀ s, s ≤ layerLo N a b i + δ → layerClock N a b i s = 0) ∧
      (∀ s, layerHi N a b i - δ ≤ s → layerClock N a b i s = 1)) := by
  have hD := layerStep_pos N hab
  have hDeq := layerStep_mul N (a := a) (b := b)
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · intro i
    have hiN : (i.val : ℝ) + 1 ≤ N := by exact_mod_cast i.isLt
    have hi0 : 0 ≤ (i.val : ℝ) := Nat.cast_nonneg _
    unfold layerLo layerHi
    refine ⟨by nlinarith, by nlinarith, by nlinarith⟩
  · intro i j hij
    have hv : (i.val : ℝ) + 1 ≤ j.val := by exact_mod_cast hij
    unfold layerLo layerHi
    nlinarith
  · intro i
    exact ⟨intervalClock_smooth _ _, intervalClock_monotone (layerClock_between N hab i)⟩
  · intro i s
    exact ⟨(intervalClock_bounds _ _ _).1, (intervalClock_bounds _ _ _).2,
      intervalClock_deriv_nonneg (layerClock_between N hab i) s⟩
  · intro i
    exact ⟨layerStep N a b / 4, by positivity,
      fun _ hs => intervalClock_zero (layerClock_between N hab i) hs,
      fun _ hs => intervalClock_one (layerClock_between N hab i) hs⟩

/-- On the `i`-th layer interval the final layer Hamiltonian is the `i`-th layer
Hamiltonian (the explicit form of the last clause of `exists_surface_layer_clocks`). -/
theorem layerClocks_final (N : ℕ) {a b : ℝ} (hab : a < b) {E : Type*} (J R : E → ℝ)
    (h : Fin N → E → ℝ) (i : Fin N) {s : ℝ}
    (hs : s ∈ Icc (layerLo (N + 1) a b i.castSucc) (layerHi (N + 1) a b i.castSucc)) (v : E) :
    surfaceFinalLayer J h R (fun j => layerClock (N + 1) a b j.castSucc)
        (layerClock (N + 1) a b (Fin.last N)) (s, v) =
      J v + (∑ j ∈ Finset.univ.filter (fun j : Fin N => j < i), h j v) +
        layerClock (N + 1) a b i.castSucc s * h i v := by
  obtain ⟨-, hord, -, -, hcol⟩ := layerClocks_spec (N + 1) hab
  apply surfaceFinalLayer_on_ordered_interval J R h hord _ i hs v
  intro j
  obtain ⟨δ, hδ, hz, ho⟩ := hcol j
  exact ⟨fun s hs => hz s (by linarith), fun s hs => ho s (by linarith)⟩

/-! ### Explicit smoothed caps -/

/-- The smooth ramp `x · smoothTransition (x / c)`: `0` for `x ≤ 0`, `x` for `x ≥ c`. -/
def capRamp (c x : ℝ) : ℝ := x * Real.smoothTransition (x / c)

theorem capRamp_smooth (c : ℝ) : ContDiff ℝ ∞ (capRamp c) :=
  contDiff_id.mul (Real.smoothTransition.contDiff.comp (contDiff_id.div_const c))

theorem capRamp_nonneg {c : ℝ} (hc : 0 < c) (x : ℝ) : 0 ≤ capRamp c x := by
  unfold capRamp
  rcases le_or_gt x 0 with hx | hx
  · rw [Real.smoothTransition.zero_of_nonpos (div_nonpos_of_nonpos_of_nonneg hx hc.le), mul_zero]
  · exact mul_nonneg hx.le (Real.smoothTransition.nonneg _)

theorem capRamp_le {c : ℝ} (hc : 0 < c) (x : ℝ) : capRamp c x ≤ max x 0 := by
  unfold capRamp
  rcases le_or_gt x 0 with hx | hx
  · rw [Real.smoothTransition.zero_of_nonpos (div_nonpos_of_nonpos_of_nonneg hx hc.le), mul_zero]
    exact le_max_right _ _
  · calc x * Real.smoothTransition (x / c) ≤ x * 1 :=
          mul_le_mul_of_nonneg_left (Real.smoothTransition.le_one _) hx.le
      _ = x := mul_one x
      _ ≤ max x 0 := le_max_left _ _

theorem sub_le_capRamp {c : ℝ} (hc : 0 < c) (x : ℝ) : x - c ≤ capRamp c x := by
  rcases le_or_gt c x with hx | hx
  · unfold capRamp
    rw [Real.smoothTransition.one_of_one_le ((one_le_div hc).2 hx), mul_one]
    linarith
  · linarith [capRamp_nonneg hc x]

/-- The explicit smoothed cap `h_i(p) = ramp_{c_i}(a_i − |p|)`, `c_i = (a_i − r_i)/2`. -/
def smoothCap {m k : ℕ} (a r : Fin k → ℝ) (i : Fin k) (p : Moments m) : ℝ :=
  capRamp ((a i - r i) / 2) (a i - ∑ j, p j)

theorem smoothCap_smooth {m k : ℕ} (a r : Fin k → ℝ) (i : Fin k) :
    ContDiff ℝ ∞ (smoothCap (m := m) a r i) :=
  (capRamp_smooth _).comp (contDiff_const.sub (ContDiff.sum fun j _ => contDiff_apply ℝ ℝ j))

theorem smoothCap_nonneg {m k : ℕ} {a r : Fin k → ℝ} {i : Fin k} (h : r i < a i)
    (p : Moments m) : 0 ≤ smoothCap a r i p :=
  capRamp_nonneg (by linarith) _

theorem smoothCap_le {m k : ℕ} {a r : Fin k → ℝ} {i : Fin k} (h : r i < a i)
    (p : Moments m) : smoothCap a r i p ≤ max (a i - ∑ j, p j) 0 :=
  capRamp_le (by linarith) _

theorem smoothCap_ge {m k : ℕ} {a r : Fin k → ℝ} {i : Fin k} (h : r i < a i)
    (p : Moments m) : (a i + r i) / 2 - ∑ j, p j ≤ smoothCap a r i p := by
  have := sub_le_capRamp (c := (a i - r i) / 2) (by linarith) (a i - ∑ j, p j)
  unfold smoothCap; linarith

/-- The sum of the smoothed caps is bounded by the cap profile `Σ_i (a_i − |p|)_+`. -/
theorem sum_smoothCap_le {m k : ℕ} {a r : Fin k → ℝ} (h : ∀ i, r i < a i) (p : Moments m) :
    ∑ i, smoothCap a r i p ≤ ∑ i, max (a i - ∑ j, p j) 0 :=
  Finset.sum_le_sum fun i _ => smoothCap_le (h i) p

/-! ### The comparator isotopy as a compactly supported Hamiltonian isotopy -/

variable {m : ℕ}

/-- The Hamiltonian `(t, w) ↦ Q t w` of a generator. -/
def genHam (Q : ℝ → Fibre m → ℝ) (x : ℝ × Fibre m) : ℝ := Q x.1 x.2

theorem genHam_compact {Q : ℝ → Fibre m → ℝ} (hQ : GenSpec Q) : HasCompactSupport (genHam Q) := by
  obtain ⟨R, hR⟩ := hQ.support
  refine HasCompactSupport.intro (K := Icc (0 : ℝ) 1 ×ˢ Metric.closedBall (0 : Fibre m) R)
    (isCompact_Icc.prod (isCompact_closedBall 0 R)) ?_
  rintro ⟨t, w⟩ hp
  simp only [mem_prod, Metric.mem_closedBall, dist_zero_right, not_and_or, not_le] at hp
  rcases hp with ht | hw
  · exact hR t w (Or.inl ht)
  · exact hR t w (Or.inr hw.le)

/-- The comparator field is the library's Hamiltonian field of `genHam Q` (both with the
convention `ι_X ω = −dQ`). -/
theorem fibreHamVF_eq_hamiltonianField {Q : ℝ → Fibre m → ℝ} (hQ : GenSpec Q) (t : ℝ)
    (w : Fibre m) :
    fibreHamVF Q t w = hamiltonianField phaseArea (genHam Q) (t, w) := by
  apply phaseArea_injective
  apply ContinuousLinearMap.ext
  intro u
  rw [hamiltonianField_contraction phaseArea_isInvertible]
  -- the slice derivative of `genHam Q`
  have hdiff : DifferentiableAt ℝ (genHam Q) (t, w) :=
    (hQ.smooth.differentiable (by simp)) (t, w)
  have hslice : fderiv ℝ (genHam Q) (t, w) (0, u) = fderiv ℝ (Q t) w u := by
    have hcomp : (Q t) = genHam Q ∘ (fun v : Fibre m => (t, v)) := rfl
    have hin : HasFDerivAt (fun v : Fibre m => (t, v))
        ((0 : Fibre m →L[ℝ] ℝ).prod (ContinuousLinearMap.id ℝ (Fibre m))) w :=
      (hasFDerivAt_const t w).prodMk (hasFDerivAt_id w)
    rw [hcomp, (hdiff.hasFDerivAt.comp w hin).fderiv]
    rfl
  rw [hslice, phaseArea_apply]
  -- expand `u` in the coordinate basis
  set L := fderiv ℝ (Q t) w
  have hu : u = ∑ j, ((u j).1 • (Pi.single j ((1 : ℝ), (0 : ℝ)) : Fibre m) +
      (u j).2 • (Pi.single j ((0 : ℝ), (1 : ℝ)) : Fibre m)) := by
    ext i <;> simp [Finset.sum_apply, Pi.single_apply, Prod.fst_sum, Prod.snd_sum,
      apply_ite Prod.fst, apply_ite Prod.snd]
  have hLu : L u = ∑ j, ((u j).1 * L (Pi.single j (1, 0)) + (u j).2 * L (Pi.single j (0, 1))) := by
    conv_lhs => rw [hu]
    simp [map_sum, map_add, map_smul, smul_eq_mul]
  rw [hLu, ← Finset.sum_neg_distrib]
  apply Finset.sum_congr rfl
  intro j _
  simp only [fibreHamVF]
  ring

/-- The flow of a generator as a homeomorphism at each time. -/
def genFlowEquiv (Q : ℝ → Fibre m → ℝ) (hQ : GenSpec Q) (t : ℝ) : Fibre m ≃ₜ Fibre m where
  toFun := isoOf Q t
  invFun := Return.flowInv (fibreHamVF Q) t
  left_inv := hQ.csField.flowInv_flow t
  right_inv := hQ.csField.flow_flowInv t
  continuous_toFun := (hQ.csField.flow_slice_smooth t).continuous
  continuous_invFun := (hQ.csField.flowInv_slice_smooth t).continuous

/-- The time-`t` map agrees with the library's endpoint map of `genHam Q`. -/
theorem genFlow_endpoint {Q : ℝ → Fibre m → ℝ} (hQ : GenSpec Q) (t : ℝ) :
    ∃ Φ : Fibre m ≃ₜ Fibre m, (∀ x, Φ x = isoOf Q t x) ∧
      (∀ x, x ∉ Prod.snd '' tsupport (genHam Q) → Φ x = x) ∧
      (∀ x v w, phaseArea (fderiv ℝ Φ x v) (fderiv ℝ Φ x w) = phaseArea v w) := by
  obtain ⟨Φ, -, -, hfix, -, hsymp, hsol⟩ := exists_hamiltonian_endpoint phaseArea_isInvertible
    phaseArea_skew hQ.smooth (genHam_compact hQ) 0 t
  refine ⟨Φ, fun x => ?_, hfix, hsymp⟩
  have hc := hQ.csField
  have h := hsol (fun s => isoOf Q s x) (hc.flowFrom_continuous 0 x) (fun s => by
    have hd := hc.flow_hasDerivAt x s
    rw [fibreHamVF_eq_hamiltonianField hQ] at hd
    exact hd)
  simpa only [zero_add, isoOf, hc.flow_zero] using h

/-- **The comparator isotopy**: the flow of the generator `Q` as a compactly supported
Hamiltonian isotopy of `(ℂ^m, phaseArea)` with Hamiltonian `genHam Q`. -/
def comparatorIsotopy (Q : ℝ → Fibre m → ℝ) (hQ : GenSpec Q) :
    CompactHamiltonianIsotopy (phaseArea (ι := Fin m)) where
  map := genFlowEquiv Q hQ
  smooth := hQ.csField.flow_smooth
  inverse_smooth := hQ.csField.flowInv_smooth
  zero := Homeomorph.ext fun x => hQ.csField.flow_zero x
  hamiltonian := genHam Q
  hamiltonian_smooth := hQ.smooth
  compact := genHam_compact hQ
  flow := fun t x => by
    rw [← fibreHamVF_eq_hamiltonianField hQ]
    exact hQ.csField.flow_hasDerivAt x t
  symplectic := fun t x v w => by
    obtain ⟨Φ, hΦ, -, hsymp⟩ := genFlow_endpoint hQ t
    have he : (genFlowEquiv Q hQ t : Fibre m → Fibre m) = Φ := funext fun y => (hΦ y).symm
    rw [he]
    exact hsymp x v w
  fixed := fun t x hx => by
    obtain ⟨Φ, hΦ, hfix, -⟩ := genFlow_endpoint hQ t
    exact (hΦ x).symm.trans (hfix x hx)

theorem comparatorIsotopy_map {Q : ℝ → Fibre m → ℝ} (hQ : GenSpec Q) (t : ℝ) (w : Fibre m) :
    (comparatorIsotopy Q hQ).map t w = isoOf Q t w := rfl

/-- The zero generator. -/
theorem zeroGen_spec : GenSpec (fun (_ : ℝ) (_ : Fibre m) => (0 : ℝ)) :=
  ⟨contDiff_const, ⟨0, fun _ _ _ => rfl⟩⟩

open Classical in
/-- The isotopy of a comparison datum (the identity isotopy if `D.Q` is not a generator). -/
def fibreIsotopy (D : ComparisonDatum m) : CompactHamiltonianIsotopy (phaseArea (ι := Fin m)) :=
  if h : GenSpec D.Q then comparatorIsotopy D.Q h else comparatorIsotopy _ zeroGen_spec

theorem fibreIsotopy_map {D : ComparisonDatum m} (h : GenSpec D.Q) (t : ℝ) (w : Fibre m) :
    (fibreIsotopy D).map t w = isoOf D.Q t w := by
  simp only [fibreIsotopy, dif_pos h, comparatorIsotopy_map]

theorem fibreIsotopy_map_one {D : ComparisonDatum m} (h : GenSpec D.Q) (w : Fibre m) :
    (fibreIsotopy D).map 1 w = D.qMap w :=
  fibreIsotopy_map h 1 w

theorem fibreIsotopy_hamiltonian {D : ComparisonDatum m} (h : GenSpec D.Q) :
    (fibreIsotopy D).hamiltonian = genHam D.Q := by
  simp only [fibreIsotopy, dif_pos h]
  rfl

/-! ### The split layer form -/

variable {M : Type} [TopologicalSpace M] [ChartedSpace (ℝ × ℝ) M]
  [IsManifold 𝓘(ℝ, ℝ × ℝ) ∞ M]
variable {q k : ℕ}

/-- The split form for an isotopy `Φ`, comparator `K`, handle mass `H` and normalized primitive
`Γ`: the library's second-path form at time one, with the explicit clocks `layerClock` on
`k + 1` subintervals of `(−b, b)` (the last one residual) and the explicit caps `smoothCap`. -/
def layerFormOf (T : ToricModel M m q) (Φ : CompactHamiltonianIsotopy (phaseArea (ι := Fin m)))
    (K H : Moments m → ℝ) (Γ : Moments m → ManifoldOneForm (ℝ × ℝ) M) (a r : Fin k → ℝ) :
    ManifoldTwoForm ((ℝ × ℝ) × Fibre m) (M × Fibre m) :=
  globalHorizontalCoupling phaseArea (fun v =>
    T.handle.globalSurfaceSecondPrimitive T.hb Φ (K ∘ planeMoments) (H ∘ planeMoments)
      (fun i => smoothCap a r i ∘ planeMoments)
      (fun i => layerClock (k + 1) (-T.hb) T.hb i.castSucc)
      (layerClock (k + 1) (-T.hb) T.hb (Fin.last k))
      (Γ ∘ planeMoments) (1, v))

end ToricPackingStages

end SymplecticPacking.HighDim
