import SymplecticPacking.HighDim.Handle.QuadricGridParameters

/-!
# A finite algebraic atlas of the quadric

A fixed finite algebraic atlas, generated by rational grid tests and all finite root signs.
-/

noncomputable section
namespace SymplecticPacking.HighDim.ToricPackingStages
open Set Function
open OAI.PackingSufficiencySupport.DiagonalQuadrics

abbrev QuadricFiniteIndex {m : ℕ} (a : Fin m → ℚ) (R : ℚ) :=
  OrdinaryGridIndex a R (quadricGridRadius R) quadricGridThreshold
    (quadricGridSize R) (quadricGridMesh R) ⊕ (Fin m × Bool × (Fin m → Bool))

section
variable {m : ℕ} (a : Fin m → ℚ)
  [Fact (Injective (fun j => (a j:ℂ)))] [Fact (∀ j, (a j:ℂ) ≠ 0)]

def uniformBranchBox (hsep₀ : ∀ i, 1 ≤ ‖(a i:ℂ)‖)
    (hsep : ∀ i j, j≠i → 1 ≤ ‖(a i:ℂ)-(a j:ℂ)‖)
    (i : Fin m) (ε₀ : Bool) (ε : Fin m → Bool) :
    RawCoordinateBox (locus (fun j => (a j:ℂ))) :=
  let c := branchPresentationCenter (fun j => (a j:ℂ)) i ε₀ ε
  branchRawBox c i (branchPresentationCenter_regular _ Fact.out Fact.out i ε₀ ε)
    (1/8) (by norm_num)
    (by
      change 2*(1/8:ℝ)*(2*‖(if i=i then 0 else signedRoot (ε i) ((a i:ℂ)-(a i:ℂ)))‖+2*(1/8)) <
        ‖signedRoot ε₀ (a i:ℂ)‖^2
      rw [ite_eq_left rfl, norm_zero, norm_signedRoot_sq]
      linarith [hsep₀ i])
    (by
      intro j hji
      change 2*(1/8:ℝ)*(2*‖(if i=i then 0 else signedRoot (ε i) ((a i:ℂ)-(a i:ℂ)))‖+2*(1/8)) <
        ‖if j=i then 0 else signedRoot (ε j) ((a i:ℂ)-(a j:ℂ))‖^2
      rw [ite_eq_left rfl, ite_eq_right hji, norm_zero, norm_signedRoot_sq]
      linarith [hsep i j hji])

def quadricFiniteBox {R : ℚ} (hR : 0 ≤ R) (hsep₀ : ∀ i, 1 ≤ ‖(a i:ℂ)‖)
    (hsep : ∀ i j, j≠i → 1 ≤ ‖(a i:ℂ)-(a j:ℂ)‖)
    (idx : QuadricFiniteIndex a R) : RawCoordinateBox (locus (fun j => (a j:ℂ))) :=
  match idx with
  | .inl i => ordinaryGridBox a hR i
  | .inr (i, ε₀, ε) => uniformBranchBox a hsep₀ hsep i ε₀ ε

theorem uniformBranchBox_smooth (hsep₀ : ∀ i, 1 ≤ ‖(a i:ℂ)‖)
    (hsep : ∀ i j, j≠i → 1 ≤ ‖(a i:ℂ)-(a j:ℂ)‖)
    (i : Fin m) (ε₀ : Bool) (ε : Fin m → Bool) :
    (uniformBranchBox a hsep₀ hsep i ε₀ ε).Smooth := by
  let c := branchPresentationCenter (fun j => (a j:ℂ)) i ε₀ ε
  have hc := branchPresentationCenter_regular (fun j => (a j:ℂ)) Fact.out Fact.out i ε₀ ε
  exact ⟨(branchRealExplicitChart_smooth c i hc).contMDiffOn,
    branchRealExplicitChart_inverse_smooth c i hc⟩

theorem quadricFiniteBox_inside {R : ℚ} (hR : 0 ≤ R) (hsep₀ : ∀ i, 1 ≤ ‖(a i:ℂ)‖)
    (hsep : ∀ i j, j≠i → 1 ≤ ‖(a i:ℂ)-(a j:ℂ)‖)
    (hbranch : ∀ i, ‖(a i:ℂ)‖+1/16 < ((R:ℝ)+1)^2)
    (idx : QuadricFiniteIndex a R) :
    (quadricFiniteBox a hR hsep₀ hsep idx).compactCarrier ⊆
      interior (projectionDomain (fun j => (a j:ℂ)) ((R:ℝ)+1)) := by
  cases idx with
  | inl i => exact ordinaryGridBox_inside a hR i
  | inr idx =>
    apply branchRawBox_inside
    · simp only [branchPresentationCenter, ite_true]
    · simp only [branchPresentationCenter, ite_true, norm_zero, norm_signedRoot_sq]
      linarith [hsep₀ idx.1]
    · intro j hji
      simp only [branchPresentationCenter, ite_true, ite_eq_right hji, norm_zero, norm_signedRoot_sq]
      linarith [hsep idx.1 j hji]
    · have hh : 0 ≤ (R:ℝ) := by exact_mod_cast hR
      linarith
    · convert hbranch idx.1 using 1 <;> norm_num
end

#check_explicit quadricFiniteBox
end SymplecticPacking.HighDim.ToricPackingStages
