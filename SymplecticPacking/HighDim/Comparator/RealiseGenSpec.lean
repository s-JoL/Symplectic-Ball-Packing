import SymplecticPacking.HighDim.Comparator.Poly
import SymplecticPacking.HighDim.Comparator.Isotopy
import SymplecticPacking.HighDim.Comparator.RealiseGen
import SymplecticPacking.HighDim.Comparator.LiftFamilyBasic
import SymplecticPacking.HighDim.Comparator.LiftFamilyEstimate

/-!
# The lift of a planar slice family (supplement S-def:plc-slice (7), S-lem:plc-faces, S-thm:plc-lift)

`thm:cmp-realisation` is split into a planar part and a lift.

* A *slice family* is a function `G : Moments m → ℝ → ℝ² → ℝ`, `G y t u`, where `y` plays the role
  of the other moments `(p_i)_{i ≠ j}` (its `j`-th entry is ignored by the lift) and `G y` is a
  time-dependent planar generator. Its planar flow is `planarFlow (G y)` (convention
  `ι_X ω = −dG`, as for fibre generators). `SliceFamilySpec` lists what the planar construction
  delivers: joint smoothness, uniform compact support in `[0,1] × (y,u)`, vanishing near every
  outer face with `b_{νj} > 0`, invariance of the slice discs `{π|u|² ≤ L_j(y)}` for `y ∈ Δ_j`, and
  the realisation estimate `F(y, π|q_{y,1}(u)|²) ≤ (R_j F)(y, π|u|²) + e`.
* The lift `sliceLift j G t w = G (y(w)) t w_j`, `y(w) = (π|w_i|²)_{i≠j}` (`sliceBase`).
  `sliceLift_spec` proves: `GenSpec`, `PreservesRegion`, `FaceCollar` and the estimate, from
  `SliceFamilySpec` alone. The flow analysis is the one of S-thm:plc-lift: the moments `p_i`,
  `i ≠ j`, are first integrals (the lift is invariant under the rotations of the `i`-th plane), and
  the `j`-th coordinate then solves the planar equation of `G (y(w))`.
* `liftGen_eq`: the explicit generator `RealiseGen.liftGen` is `sliceLift j (liftFamily …)`, so
  `liftGen_spec` (thm:cmp-realisation) follows from `liftFamily_spec`, the slice-data and
  planar-rescaling part (S-lem:plc-slice, S-lem:plc-faces (b), S-thm:plc-lift (a),(c)), which is
  proved from `RealiseGen.planarGen_spec`.
-/

noncomputable section

namespace SymplecticPacking.HighDim

open Set
open OAI.PackingSufficiencySupport.Hamiltonian (PlanePhase planeMoments radialArea)
open OAI.PackingSufficiencySupport.MomentPolytope (Moments region planeRegion)
open scoped ContDiff

variable {m q : ℕ}

/-! ### Planar generators and the slice-family interface -/

/-- The planar field of a time-dependent planar generator `g` (convention `ι_X ω = −dg`):
`ẋ = −∂_y g`, `ẏ = ∂_x g`. -/
def planarVF (g : ℝ → ℝ × ℝ → ℝ) (t : ℝ) (u : ℝ × ℝ) : ℝ × ℝ :=
  (-(fderiv ℝ (g t) u (0, 1)), fderiv ℝ (g t) u (1, 0))

/-- The planar isotopy generated by `g` (unique integral curves, `Return.flow`). -/
def planarFlow (g : ℝ → ℝ × ℝ → ℝ) (t : ℝ) (u : ℝ × ℝ) : ℝ × ℝ :=
  Return.flow (planarVF g) t u

/-- The other moments as a point of `Moments m` with `j`-th entry `0`. -/
def sliceBase (j : Fin m) (p : Moments m) : Moments m := fun i => if i = j then 0 else p i

/-- **The lift** of a slice family: `Q(t, w) = G(y(w), t, w_j)`. -/
def sliceLift (j : Fin m) (G : Moments m → ℝ → ℝ × ℝ → ℝ) (t : ℝ) (w : Fibre m) : ℝ :=
  G (sliceBase j (planeMoments w)) t (w j)

/-- What the planar construction delivers (S-thm:plc-param with the slice data of
S-def:plc-slice, S-lem:plc-faces (b), and the estimate of S-thm:plc-lift (c)). -/
structure SliceFamilySpec (Δ : Polytope m q) (F : PolyFn m) (j : Fin m) (e : ℝ)
    (G : Moments m → ℝ → ℝ × ℝ → ℝ) : Prop where
  smooth : ContDiff ℝ ∞ (fun x : Moments m × ℝ × (ℝ × ℝ) => G x.1 x.2.1 x.2.2)
  support : ∃ R : ℝ, ∀ y t u, y j = 0 → (t ∉ Icc (0 : ℝ) 1 ∨ R ≤ ‖y‖ ∨ R ≤ ‖u‖) → G y t u = 0
  collar : ∃ c > 0, ∀ ν, 0 < Δ.b ν j → ∀ y t u, y j = 0 →
    Δ.ℓ ν - c < ∑ i, Δ.b ν i * Function.update y j (radialArea u) i → G y t u = 0
  disc : ∀ p ∈ Δ.set, ∀ t u, radialArea u ≤ Δ.sliceLen j p →
    radialArea (planarFlow (G (sliceBase j p)) t u) ≤ Δ.sliceLen j p
  estimate : ∀ p ∈ Δ.set, ∀ u : ℝ × ℝ, radialArea u = p j →
    PolyFn.eval F (Function.update p j (radialArea (planarFlow (G (sliceBase j p)) 1 u))) ≤
      rearr Δ j (PolyFn.eval F) p + e

/-! ### Elementary identities -/

theorem radialArea_eq (u : ℝ × ℝ) : radialArea u = Real.pi * (u.1 ^ 2 + u.2 ^ 2) := rfl

theorem radialArea_nonneg (u : ℝ × ℝ) : 0 ≤ radialArea u := by
  rw [radialArea_eq]; positivity

theorem contDiff_radialArea : ContDiff ℝ ∞ radialArea := by
  have : radialArea = fun u : ℝ × ℝ => Real.pi * (u.1 ^ 2 + u.2 ^ 2) := rfl
  rw [this]
  exact contDiff_const.mul ((contDiff_fst.pow 2).add (contDiff_snd.pow 2))

theorem planeMoments_apply (w : Fibre m) (i : Fin m) : planeMoments w i = radialArea (w i) := rfl

theorem sliceBase_update (j : Fin m) (p : Moments m) (x : ℝ) :
    sliceBase j (Function.update p j x) = sliceBase j p := by
  funext i
  by_cases h : i = j
  · simp [sliceBase, h]
  · simp [sliceBase, h, Function.update_of_ne h]

theorem update_sliceBase (j : Fin m) (p : Moments m) (x : ℝ) :
    Function.update (sliceBase j p) j x = Function.update p j x := by
  funext i
  by_cases h : i = j
  · subst h; simp
  · simp [sliceBase, h, Function.update_of_ne h]

theorem planeMoments_update (w : Fibre m) (j : Fin m) (u : ℝ × ℝ) :
    planeMoments (Function.update w j u) = Function.update (planeMoments w) j (radialArea u) := by
  funext i
  by_cases h : i = j
  · subst h; simp [planeMoments_apply]
  · simp [planeMoments_apply, Function.update_of_ne h]

theorem sliceBase_planeMoments_update (w : Fibre m) (j : Fin m) (u : ℝ × ℝ) :
    sliceBase j (planeMoments (Function.update w j u)) = sliceBase j (planeMoments w) := by
  rw [planeMoments_update, sliceBase_update]

/-! ### Smoothness and support of the lift -/

section lift

variable {j : Fin m} {G : Moments m → ℝ → ℝ × ℝ → ℝ}

theorem contDiff_sliceBase_planeMoments (j : Fin m) :
    ContDiff ℝ ∞ (fun w : Fibre m => sliceBase j (planeMoments w)) := by
  refine contDiff_pi.mpr fun i => ?_
  by_cases h : i = j
  · simp only [sliceBase, h, if_true]; exact contDiff_const
  · simp only [sliceBase, h, if_false, planeMoments_apply]
    exact contDiff_radialArea.comp (contDiff_apply ℝ (ℝ × ℝ) i)

theorem sliceLift_smooth
    (hs : ContDiff ℝ ∞ (fun x : Moments m × ℝ × (ℝ × ℝ) => G x.1 x.2.1 x.2.2)) :
    ContDiff ℝ ∞ (fun x : ℝ × Fibre m => sliceLift j G x.1 x.2) := by
  have h1 : ContDiff ℝ ∞ (fun x : ℝ × Fibre m =>
      ((sliceBase j (planeMoments x.2), x.1, x.2 j) : Moments m × ℝ × (ℝ × ℝ))) :=
    ((contDiff_sliceBase_planeMoments j).comp contDiff_snd).prodMk
      (contDiff_fst.prodMk ((contDiff_apply ℝ (ℝ × ℝ) j).comp contDiff_snd))
  exact hs.comp h1

theorem norm_le_of_radialArea {u : ℝ × ℝ} : ‖u‖ ^ 2 ≤ radialArea u := by
  rw [radialArea_eq, Prod.norm_def]
  have h1 : ‖u.1‖ ^ 2 = u.1 ^ 2 := by rw [Real.norm_eq_abs, sq_abs]
  have h2 : ‖u.2‖ ^ 2 = u.2 ^ 2 := by rw [Real.norm_eq_abs, sq_abs]
  have hpi : (1 : ℝ) ≤ Real.pi := by linarith [Real.pi_gt_three]
  rcases le_total ‖u.1‖ ‖u.2‖ with h | h
  · rw [max_eq_right h, h2]
    nlinarith [sq_nonneg u.1, sq_nonneg u.2]
  · rw [max_eq_left h, h1]
    nlinarith [sq_nonneg u.1, sq_nonneg u.2]

theorem sliceLift_genSpec
    (hs : ContDiff ℝ ∞ (fun x : Moments m × ℝ × (ℝ × ℝ) => G x.1 x.2.1 x.2.2))
    (hsupp : ∃ R : ℝ, ∀ y t u, y j = 0 → (t ∉ Icc (0 : ℝ) 1 ∨ R ≤ ‖y‖ ∨ R ≤ ‖u‖) → G y t u = 0) :
    GenSpec (sliceLift j G) := by
  refine ⟨sliceLift_smooth hs, ?_⟩
  obtain ⟨R, hR⟩ := hsupp
  set R₀ := max R 0 + 1 with hR₀
  refine ⟨R₀, fun t w hw => ?_⟩
  unfold sliceLift
  rcases hw with ht | hw
  · exact hR _ _ _ (by simp [sliceBase]) (Or.inl ht)
  · apply hR _ _ _ (by simp [sliceBase])
    right
    -- some coordinate of `w` has norm `≥ R₀`
    have hR₀pos : 0 < R₀ := by positivity
    obtain ⟨i, hi⟩ : ∃ i, R₀ ≤ ‖w i‖ := by
      by_contra hcon
      push_neg at hcon
      have : ‖w‖ < R₀ := (pi_norm_lt_iff hR₀pos).mpr hcon
      linarith
    by_cases hij : i = j
    · subst hij; right
      exact le_trans (by rw [hR₀]; linarith [le_max_left R 0]) hi
    · left
      have hyi : sliceBase j (planeMoments w) i = radialArea (w i) := by
        simp [sliceBase, hij, planeMoments_apply]
      have h1 : R₀ ^ 2 ≤ ‖w i‖ ^ 2 := pow_le_pow_left₀ hR₀pos.le hi 2
      have h2 := norm_le_of_radialArea (u := w i)
      have h3 : radialArea (w i) ≤ ‖sliceBase j (planeMoments w)‖ := by
        rw [← hyi]
        exact le_trans (le_abs_self _) (by
          rw [← Real.norm_eq_abs]; exact norm_le_pi_norm (sliceBase j (planeMoments w)) i)
      have h4 : R ≤ R₀ ^ 2 := by
        have h1' : 1 ≤ R₀ := by rw [hR₀]; linarith [le_max_right R 0]
        have : R₀ ≤ R₀ ^ 2 := by nlinarith
        linarith [le_max_left R 0]
      linarith

/-! ### Derivatives of the lift -/

theorem sliceLift_comp_update (t : ℝ) (w : Fibre m) :
    sliceLift j G t ∘ Function.update w j = G (sliceBase j (planeMoments w)) t := by
  funext u
  simp only [Function.comp, sliceLift, sliceBase_planeMoments_update, Function.update_self]

theorem pi_single_id_apply (j : Fin m) (v : ℝ × ℝ) :
    (ContinuousLinearMap.pi (Pi.single j (ContinuousLinearMap.id ℝ (ℝ × ℝ))) :
      (ℝ × ℝ) →L[ℝ] Fibre m) v = Pi.single j v := by
  funext i
  by_cases h : i = j
  · subst h; simp
  · simp [h]

/-- The `j`-th partial derivative of the lift is that of the planar generator. -/
theorem fderiv_sliceLift_single (hd : ∀ t, Differentiable ℝ (sliceLift j G t)) (t : ℝ)
    (w : Fibre m) (v : ℝ × ℝ) :
    fderiv ℝ (sliceLift j G t) w (Pi.single j v) =
      fderiv ℝ (G (sliceBase j (planeMoments w)) t) (w j) v := by
  have hQ : HasFDerivAt (sliceLift j G t) (fderiv ℝ (sliceLift j G t) w)
      (Function.update w j (w j)) := by
    rw [Function.update_eq_self]; exact (hd t w).hasFDerivAt
  have h1 := hQ.comp (w j) (hasFDerivAt_update w (w j))
  rw [sliceLift_comp_update] at h1
  rw [h1.fderiv, ContinuousLinearMap.comp_apply, pi_single_id_apply]

/-- The rotation of the `i`-th plane by angle `θ`. -/
def rotPlane (i : Fin m) (θ : ℝ) (w : Fibre m) : Fibre m :=
  Function.update w i (Real.cos θ * (w i).1 - Real.sin θ * (w i).2,
    Real.sin θ * (w i).1 + Real.cos θ * (w i).2)

theorem radialArea_rot (θ : ℝ) (x y : ℝ) :
    radialArea (Real.cos θ * x - Real.sin θ * y, Real.sin θ * x + Real.cos θ * y) =
      radialArea (x, y) := by
  rw [radialArea_eq, radialArea_eq]
  have := Real.sin_sq_add_cos_sq θ
  simp only
  congr 1
  linear_combination (x ^ 2 + y ^ 2) * this

theorem sliceLift_rotPlane {i : Fin m} (hij : i ≠ j) (t θ : ℝ) (w : Fibre m) :
    sliceLift j G t (rotPlane i θ w) = sliceLift j G t w := by
  unfold sliceLift rotPlane
  rw [planeMoments_update, radialArea_rot, Function.update_of_ne hij.symm]
  congr 2
  rw [show ((w i).1, (w i).2) = w i from rfl, show radialArea (w i) = planeMoments w i from rfl,
    Function.update_eq_self]

theorem hasDerivAt_rotPlane (i : Fin m) (w : Fibre m) :
    HasDerivAt (fun θ => rotPlane i θ w) (Pi.single i (-(w i).2, (w i).1)) 0 := by
  have hr : HasDerivAt (fun θ : ℝ =>
      ((Real.cos θ * (w i).1 - Real.sin θ * (w i).2,
        Real.sin θ * (w i).1 + Real.cos θ * (w i).2) : ℝ × ℝ))
      ((-(w i).2, (w i).1) : ℝ × ℝ) 0 := by
    have h1 := ((Real.hasDerivAt_cos 0).mul_const (w i).1).sub
      ((Real.hasDerivAt_sin 0).mul_const (w i).2)
    have h2 := ((Real.hasDerivAt_sin 0).mul_const (w i).1).add
      ((Real.hasDerivAt_cos 0).mul_const (w i).2)
    have := h1.prodMk h2
    convert this using 1
    simp
  have := (hasFDerivAt_update (𝕜 := ℝ) w (i := i) _).comp_hasDerivAt (0 : ℝ) hr
  convert this using 1
  all_goals first | rfl | (funext θ; rfl) | rw [pi_single_id_apply]

/-- The lift is invariant under the rotations of the planes `i ≠ j`. -/
theorem fderiv_sliceLift_rot (hd : ∀ t, Differentiable ℝ (sliceLift j G t)) {i : Fin m}
    (hij : i ≠ j) (t : ℝ) (w : Fibre m) :
    fderiv ℝ (sliceLift j G t) w (Pi.single i (-(w i).2, (w i).1)) = 0 := by
  have hw0 : rotPlane i 0 w = w := by simp [rotPlane]
  have hQ : HasFDerivAt (sliceLift j G t) (fderiv ℝ (sliceLift j G t) w) (rotPlane i 0 w) := by
    rw [hw0]; exact (hd t w).hasFDerivAt
  have h1 := hQ.comp_hasDerivAt (0 : ℝ) (hasDerivAt_rotPlane i w)
  have hconst : (sliceLift j G t ∘ fun θ => rotPlane i θ w) = fun _ => sliceLift j G t w := by
    funext θ; exact sliceLift_rotPlane hij t θ w
  rw [hconst] at h1
  exact h1.unique (hasDerivAt_const 0 _)

/-! ### Moments along fibre fields -/

/-- The differential of `p_i = π|w_i|²`. -/
def momentD (i : Fin m) (w : Fibre m) : Fibre m →L[ℝ] ℝ :=
  (2 * Real.pi * (w i).1) • ((ContinuousLinearMap.fst ℝ ℝ ℝ).comp
      (ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin m => ℝ × ℝ) i)) +
    (2 * Real.pi * (w i).2) • ((ContinuousLinearMap.snd ℝ ℝ ℝ).comp
      (ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin m => ℝ × ℝ) i))

theorem hasFDerivAt_moment (i : Fin m) (w : Fibre m) :
    HasFDerivAt (fun w : Fibre m => planeMoments w i) (momentD i w) w := by
  set a := (ContinuousLinearMap.fst ℝ ℝ ℝ).comp
      (ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin m => ℝ × ℝ) i)
  set b := (ContinuousLinearMap.snd ℝ ℝ ℝ).comp
      (ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin m => ℝ × ℝ) i)
  have ha : HasFDerivAt (fun w : Fibre m => (w i).1) a w := a.hasFDerivAt
  have hb : HasFDerivAt (fun w : Fibre m => (w i).2) b w := b.hasFDerivAt
  have h := ((ha.mul ha).add (hb.mul hb)).const_mul Real.pi
  have hf : (fun w : Fibre m => planeMoments w i) =
      fun w => Real.pi * ((w i).1 * (w i).1 + (w i).2 * (w i).2) := by
    funext v; rw [planeMoments_apply, radialArea_eq]; ring
  rw [hf]
  convert h using 1
  ext v
  simp [momentD, a, b]
  ring

theorem momentD_fibreHamVF (Q : ℝ → Fibre m → ℝ) (i : Fin m) (t : ℝ) (w : Fibre m) :
    momentD i w (fibreHamVF Q t w) =
      -(2 * Real.pi) * fderiv ℝ (Q t) w (Pi.single i (-(w i).2, (w i).1)) := by
  have hs : (Pi.single i (-(w i).2, (w i).1) : Fibre m) =
      (-(w i).2) • (Pi.single i ((1 : ℝ), (0 : ℝ)) : Fibre m) +
        (w i).1 • (Pi.single i ((0 : ℝ), (1 : ℝ)) : Fibre m) := by
    funext k
    by_cases h : k = i
    · subst h; simp
    · simp [h]
  rw [hs, map_add, map_smul, map_smul]
  simp [momentD, fibreHamVF, smul_eq_mul]
  ring

/-! ### The flow of the lift -/

variable (hs : ContDiff ℝ ∞ (fun x : Moments m × ℝ × (ℝ × ℝ) => G x.1 x.2.1 x.2.2))
  (hsupp : ∃ R : ℝ, ∀ y t u, y j = 0 → (t ∉ Icc (0 : ℝ) 1 ∨ R ≤ ‖y‖ ∨ R ≤ ‖u‖) → G y t u = 0)
include hs hsupp

theorem sliceLift_differentiable (t : ℝ) : Differentiable ℝ (sliceLift j G t) :=
  fun w => (sliceLift_genSpec hs hsupp).differentiableAt t w

/-- The moments `p_i`, `i ≠ j`, are first integrals of the lifted isotopy. -/
theorem planeMoments_isoOf_ne {i : Fin m} (hij : i ≠ j) (t : ℝ) (w : Fibre m) :
    planeMoments (isoOf (sliceLift j G) t w) i = planeMoments w i := by
  have hV := (sliceLift_genSpec (j := j) hs hsupp).csField
  exact hV.flow_firstIntegral (Q := fun w : Fibre m => planeMoments w i) (hasFDerivAt_moment i)
    (fun s y => by
      rw [momentD_fibreHamVF, fderiv_sliceLift_rot (sliceLift_differentiable hs hsupp) hij,
        mul_zero]) t w

theorem sliceBase_isoOf (t : ℝ) (w : Fibre m) :
    sliceBase j (planeMoments (isoOf (sliceLift j G) t w)) = sliceBase j (planeMoments w) := by
  funext i
  by_cases h : i = j
  · simp [sliceBase, h]
  · simp only [sliceBase, h, ite_false]
    exact planeMoments_isoOf_ne hs hsupp h t w

omit hs hsupp in
theorem planarVF_csField
    (hs : ContDiff ℝ ∞ (fun x : Moments m × ℝ × (ℝ × ℝ) => G x.1 x.2.1 x.2.2))
    (hsupp : ∃ R : ℝ, ∀ y t u, y j = 0 → (t ∉ Icc (0 : ℝ) 1 ∨ R ≤ ‖y‖ ∨ R ≤ ‖u‖) → G y t u = 0)
    (y : Moments m) (hy : y j = 0) : Return.CSField (planarVF (G y)) := by
  have hf : ContDiff ℝ ∞ (Function.uncurry fun (p : ℝ × (ℝ × ℝ)) (v : ℝ × ℝ) => G y p.1 v) :=
    hs.comp (contDiff_const.prodMk ((contDiff_fst.comp contDiff_fst).prodMk contDiff_snd))
  have hD : ContDiff ℝ ∞ (fun p : ℝ × (ℝ × ℝ) => fderiv ℝ (G y p.1) p.2) :=
    ContDiff.fderiv (f := fun (p : ℝ × (ℝ × ℝ)) (v : ℝ × ℝ) => G y p.1 v) hf contDiff_snd
      (le_of_eq rfl)
  refine ⟨?_, ?_⟩
  · show ContDiff ℝ ∞ (fun p : ℝ × (ℝ × ℝ) =>
      ((-(fderiv ℝ (G y p.1) p.2 (0, 1)), fderiv ℝ (G y p.1) p.2 (1, 0)) : ℝ × ℝ))
    exact (hD.clm_apply contDiff_const).neg.prodMk (hD.clm_apply contDiff_const)
  · obtain ⟨R, hR⟩ := hsupp
    refine HasCompactSupport.intro
      (K := Icc (0 : ℝ) 1 ×ˢ Metric.closedBall (0 : ℝ × ℝ) R)
      (isCompact_Icc.prod (isCompact_closedBall 0 R)) ?_
    rintro ⟨t, u⟩ hp
    simp only [mem_prod, Metric.mem_closedBall, dist_zero_right, not_and_or, not_le] at hp
    have h0 : fderiv ℝ (G y t) u = 0 := by
      rcases hp with ht | hu
      · have : G y t = fun _ => 0 := funext fun v => hR y t v hy (Or.inl ht)
        rw [this]; simp
      · have : G y t =ᶠ[nhds u] fun _ => 0 := by
          filter_upwards [(isOpen_lt continuous_const continuous_norm).mem_nhds hu] with v hv
          exact hR y t v hy (Or.inr (Or.inr (le_of_lt hv)))
        rw [this.fderiv_eq]; simp
    show planarVF (G y) t u = 0
    simp [planarVF, h0]

/-- The `j`-th coordinate of the lifted isotopy is the planar isotopy of the slice. -/
theorem isoOf_sliceLift_apply (t : ℝ) (w : Fibre m) :
    isoOf (sliceLift j G) t w j = planarFlow (G (sliceBase j (planeMoments w))) t (w j) := by
  have hV := (sliceLift_genSpec (j := j) hs hsupp).csField
  have hP := planarVF_csField hs hsupp (sliceBase j (planeMoments w)) (by simp [sliceBase])
  symm
  refine hP.flowFrom_eq (u := fun s => isoOf (sliceLift j G) s w j) ⟨?_, fun s => ?_⟩ t
  · show Return.flow (fibreHamVF (sliceLift j G)) 0 w j = w j
    rw [hV.flow_zero]
  · have h1 : HasDerivAt (fun s => isoOf (sliceLift j G) s w j)
        (fibreHamVF (sliceLift j G) s (isoOf (sliceLift j G) s w) j) s :=
      hasDerivAt_pi.mp (hV.flow_hasDerivAt w s) j
    have hb : sliceBase j (planeMoments (isoOf (sliceLift j G) s w)) =
        sliceBase j (planeMoments w) := sliceBase_isoOf hs hsupp s w
    have heq : fibreHamVF (sliceLift j G) s (isoOf (sliceLift j G) s w) j =
        planarVF (G (sliceBase j (planeMoments w))) s (isoOf (sliceLift j G) s w j) := by
      simp only [planarVF, fibreHamVF]
      rw [fderiv_sliceLift_single (sliceLift_differentiable hs hsupp),
        fderiv_sliceLift_single (sliceLift_differentiable hs hsupp), hb]
    rw [← heq]; exact h1

/-- The moment image of the lifted isotopy. -/
theorem planeMoments_isoOf (t : ℝ) (w : Fibre m) :
    planeMoments (isoOf (sliceLift j G) t w) = Function.update (planeMoments w) j
      (radialArea (planarFlow (G (sliceBase j (planeMoments w))) t (w j))) := by
  funext i
  by_cases h : i = j
  · subst h
    rw [Function.update_self, planeMoments_apply, isoOf_sliceLift_apply hs hsupp]
  · rw [Function.update_of_ne h]
    exact planeMoments_isoOf_ne hs hsupp h t w

end lift

/-! ### The lift realises the slice family -/

/-- **S-thm:plc-lift** (given the planar family): the lift of a slice family satisfying
`SliceFamilySpec` is a generator with the conclusions of `thm:cmp-realisation`. -/
theorem sliceLift_spec {Δ : Polytope m q} (hΔ : Δ.Spec) {F : PolyFn m} {j : Fin m} {e : ℝ}
    {G : Moments m → ℝ → ℝ × ℝ → ℝ} (hG : SliceFamilySpec Δ F j e G) :
    GenSpec (sliceLift j G) ∧ PreservesRegion Δ (sliceLift j G) ∧
      FaceCollar Δ (sliceLift j G) ∧
      ∀ w ∈ planeRegion Δ.b Δ.ℓ,
        PolyFn.eval F (planeMoments (isoOf (sliceLift j G) 1 w)) ≤
          rearr Δ j (PolyFn.eval F) (planeMoments w) + e := by
  have hs := hG.smooth
  have hsupp := hG.support
  have hgen := sliceLift_genSpec (j := j) hs hsupp
  refine ⟨hgen, ?_, ?_, ?_⟩
  · -- the slices `{p_j ≤ L_j(y)}` are invariant
    intro t w hw
    have hw' : planeMoments w ∈ Δ.set := hw
    show planeMoments (isoOf (sliceLift j G) t w) ∈ Δ.set
    rw [planeMoments_isoOf hs hsupp]
    refine Polytope.update_mem hΔ hw' j (radialArea_nonneg _) (hG.disc _ hw' t _ ?_)
    exact Polytope.le_sliceLen hΔ hw' j
  · -- face collars
    obtain ⟨c, hc, hcol⟩ := hG.collar
    refine ⟨c, hc, fun ν t w hw => ?_⟩
    have hsum : HasFDerivAt (fun w : Fibre m => ∑ i, Δ.b ν i * planeMoments w i)
        (∑ i, Δ.b ν i • momentD i w) w :=
      HasFDerivAt.fun_sum (u := Finset.univ) fun i _ =>
        (hasFDerivAt_moment i w).const_mul (Δ.b ν i)
    rw [hsum.fderiv, ContinuousLinearMap.sum_apply]
    refine Finset.sum_eq_zero fun i _ => ?_
    rw [ContinuousLinearMap.smul_apply, momentD_fibreHamVF, smul_eq_mul]
    by_cases hij : i = j
    · rw [hij]
      rcases (hΔ.b_nonneg ν j).lt_or_eq with hb | hb
      · -- `Q_t` vanishes near `w`
        have hcont : Continuous (fun w' : Fibre m => ∑ k, Δ.b ν k * planeMoments w' k) :=
          continuous_finsetSum _ fun k _ =>
            continuous_const.mul (contDiff_radialArea.continuous.comp (continuous_apply k))
        have hz : sliceLift j G t =ᶠ[nhds w] fun _ => 0 := by
          filter_upwards [(isOpen_lt continuous_const hcont).mem_nhds hw] with w' hw'
          apply hcol ν hb (sliceBase j (planeMoments w')) t (w' j) (by simp [sliceBase])
          rw [update_sliceBase]
          have : Function.update (planeMoments w') j (radialArea (w' j)) = planeMoments w' := by
            rw [show radialArea (w' j) = planeMoments w' j from rfl, Function.update_eq_self]
          rw [this]; exact hw'
        rw [hz.fderiv_eq]; simp
      · rw [← hb]; ring
    · rw [fderiv_sliceLift_rot (sliceLift_differentiable hs hsupp) hij]; ring
  · -- the estimate
    intro w hw
    rw [planeMoments_isoOf hs hsupp]
    exact hG.estimate _ hw (w j) rfl

/-! ### The lifted generator `RealiseGen.liftGen` is a slice lift -/

/-- The slice family of `RealiseGen.liftGen` (supplement `def:plc-slice`):
`G(y,t,u) = χ(y) S'(t) ℓ(y) B(y, χ(y) S(t), u/√ℓ(y))`. -/
def liftFamily (Δ : Polytope m q) (F : PolyFn m) (j : Fin m) (e : ℝ) :
    Moments m → ℝ → ℝ × ℝ → ℝ := fun y t u =>
  RealiseGen.cut Δ F j e y * deriv Real.smoothTransition t * RealiseGen.softLen Δ F j e y *
    RealiseGen.planarGen Δ F j e y (RealiseGen.cut Δ F j e y * Real.smoothTransition t)
      ((Real.sqrt (RealiseGen.softLen Δ F j e y))⁻¹ • u)

theorem otherMoments_eq (j : Fin m) (z : Fibre m) :
    RealiseGen.otherMoments j z = sliceBase j (planeMoments z) := by
  funext i
  by_cases h : i = j
  · subst h; simp [RealiseGen.otherMoments, sliceBase]
  · simp [RealiseGen.otherMoments, sliceBase, h, Function.update_of_ne h]

theorem liftGen_eq (Δ : Polytope m q) (F : PolyFn m) (j : Fin m) (e : ℝ) :
    RealiseGen.liftGen Δ F j e = sliceLift j (liftFamily Δ F j e) := by
  funext t z
  simp only [RealiseGen.liftGen, sliceLift, liftFamily, otherMoments_eq]

section liftFamily

variable {Δ : Polytope m q} {F : PolyFn m} {j : Fin m} {e : ℝ}

/-- The slice family vanishes outside `[0,1]` in time (flat clock). -/
theorem liftFamily_time {t : ℝ} (ht : t ∉ Icc (0 : ℝ) 1) (y : Moments m) (u : ℝ × ℝ) :
    liftFamily Δ F j e y t u = 0 := by
  have h : t ≤ 0 ∨ 1 ≤ t := by
    rcases not_and_or.mp ht with h | h
    · exact Or.inl (not_le.mp h).le
    · exact Or.inr (not_le.mp h).le
  simp [liftFamily, deriv_smoothTransition_eq_zero h]

/-- Joint smoothness (S-thm:plc-lift, smoothness part): `ℓ > 0` on a neighbourhood of
`supp χ` (S-lem:plc-slice (e),(f)), so `u/√ℓ` is smooth where the factor `χ` is non-zero. -/
theorem liftFamily_smooth (hΔ : Δ.Spec) (hF : F ≠ []) (he : 0 < e) :
    ContDiff ℝ ∞ (fun x : Moments m × ℝ × (ℝ × ℝ) => liftFamily Δ F j e x.1 x.2.1 x.2.2) := by
  have hB := (RealiseGen.planarGen_spec hΔ hF j he).smooth
  have hcut := RealiseGen.contDiff_cut Δ F j e
  have hS : ContDiff ℝ ∞ Real.smoothTransition := Real.smoothTransition.contDiff
  have hS' : ContDiff ℝ ∞ (deriv Real.smoothTransition) := (contDiff_infty_iff_deriv.mp hS).2
  rw [contDiff_iff_contDiffAt]
  intro x
  by_cases hx : x.1 ∈ tsupport (RealiseGen.cut Δ F j e)
  · have hg := RealiseGen.tsupport_cut_subset he hx
    obtain ⟨hE, hl⟩ := RealiseGen.expSum_pos_softLen_pos hΔ he hg
    have hℓ : ContDiffAt ℝ ∞ (RealiseGen.softLen Δ F j e) x.1 := by
      have hfun : RealiseGen.softLen Δ F j e = fun y => -RealiseGen.softTemp q F j e *
          Real.log (RealiseGen.expSum Δ F j e y) - RealiseGen.softShift F j e := rfl
      rw [hfun]
      exact (contDiffAt_const.mul
        ((RealiseGen.contDiff_expSum Δ F j e).contDiffAt.log hE.ne')).sub contDiffAt_const
    have hsq : ContDiffAt ℝ ∞ (fun y => (Real.sqrt (RealiseGen.softLen Δ F j e y))⁻¹) x.1 :=
      ((Real.contDiffAt_sqrt hl.ne').comp x.1 hℓ).inv (Real.sqrt_pos.mpr hl).ne'
    have hfst : ContDiffAt ℝ ∞ (fun x : Moments m × ℝ × (ℝ × ℝ) => x.1) x := contDiffAt_fst
    have hℓx := hℓ.comp x hfst
    have hsqx := hsq.comp x hfst
    have hcx := hcut.contDiffAt.comp x hfst
    have htx : ContDiffAt ℝ ∞ (fun x : Moments m × ℝ × (ℝ × ℝ) => x.2.1) x := contDiffAt_snd.fst
    have hux : ContDiffAt ℝ ∞ (fun x : Moments m × ℝ × (ℝ × ℝ) => x.2.2) x := contDiffAt_snd.snd
    have harg : ContDiffAt ℝ ∞ (fun x : Moments m × ℝ × (ℝ × ℝ) =>
        ((x.1, RealiseGen.cut Δ F j e x.1 * Real.smoothTransition x.2.1,
          (Real.sqrt (RealiseGen.softLen Δ F j e x.1))⁻¹ • x.2.2) :
            Moments m × ℝ × (ℝ × ℝ))) x :=
      hfst.prodMk ((hcx.mul (hS.contDiffAt.comp x htx)).prodMk (hsqx.smul hux))
    have hBx := hB.contDiffAt.comp x harg
    exact ((hcx.mul (hS'.contDiffAt.comp x htx)).mul hℓx).mul hBx
  · rw [notMem_tsupport_iff_eventuallyEq] at hx
    apply (contDiffAt_const (c := (0 : ℝ))).congr_of_eventuallyEq
    filter_upwards [(continuous_fst.tendsto x).eventually hx] with z hz
    simp only [Pi.zero_apply] at hz
    simp [liftFamily, hz]

/-- Spatial support (S-lem:plc-faces (a)): `χ(y) ≠ 0` forces `‖y‖_∞ < 2R` and
`π|u|² < r_B ℓ(y) ≤ r_B ℓ̄`. -/
theorem liftFamily_spatial (hΔ : Δ.Spec) (hF : F ≠ []) (he : 0 < e) :
    ∃ R : ℝ, ∀ y t u, y j = 0 → (R ≤ ‖y‖ ∨ R ≤ ‖u‖) → liftFamily Δ F j e y t u = 0 := by
  obtain ⟨rB, hrB1, hB⟩ := (RealiseGen.planarGen_spec hΔ hF j he).support
  obtain ⟨ν₀, hν₀⟩ := hΔ.bounded_dir j
  have hR := RealiseGen.two_le_boxRad hΔ
  obtain ⟨K, hK⟩ : ∃ K : ℝ,
      K = (Δ.ℓ ν₀ + ∑ i, Δ.b ν₀ i * (2 * RealiseGen.boxRad Δ)) / Δ.b ν₀ j := ⟨_, rfl⟩
  obtain ⟨K', hK'⟩ : ∃ K' : ℝ, K' = max K 1 := ⟨_, rfl⟩
  obtain ⟨R', hR'⟩ : ∃ R' : ℝ, R' = max (2 * RealiseGen.boxRad Δ + 1) (K' + 1) := ⟨_, rfl⟩
  have hKK' : K ≤ K' := hK' ▸ le_max_left _ _
  have hK'1 : 1 ≤ K' := hK' ▸ le_max_right _ _
  have hR'1 : K' + 1 ≤ R' := hR' ▸ le_max_right _ _
  have hR'2 : 2 * RealiseGen.boxRad Δ + 1 ≤ R' := hR' ▸ le_max_left _ _
  refine ⟨R', fun y t u hy h => ?_⟩
  by_cases hc : RealiseGen.cut Δ F j e y = 0
  · simp [liftFamily, hc]
  have hbox := (RealiseGen.cut_ne_zero hc).1
  have hyi : ∀ i, |y i| < 2 * RealiseGen.boxRad Δ := by
    intro i
    by_cases hi : i = j
    · rw [hi, hy, abs_zero]; linarith
    · exact RealiseGen.abs_lt_of_boxCut_ne hΔ hbox hi
  obtain ⟨-, hl⟩ :=
    RealiseGen.expSum_pos_softLen_pos hΔ he (RealiseGen.mem_goodParams_of_cut_ne he hc)
  have hlK : RealiseGen.softLen Δ F j e y ≤ K' := by
    have h1 := RealiseGen.softLen_le_faceLen (F := F) he hν₀ y
    have h2 : 0 < RealiseGen.softShift F j e := RealiseGen.softShift_pos F j he
    have hsum : ∑ i, -(Δ.b ν₀ i * (2 * RealiseGen.boxRad Δ)) ≤
        ∑ i, (if i = j then 0 else Δ.b ν₀ i * y i) :=
      Finset.sum_le_sum fun i _ => by
        have hb := hΔ.b_nonneg ν₀ i
        have := abs_lt.mp (hyi i)
        split_ifs
        · nlinarith
        · nlinarith
    have h3 : RealiseGen.faceLen Δ j ν₀ y ≤ K := by
      show (Δ.ℓ ν₀ - ∑ i, (if i = j then 0 else Δ.b ν₀ i * y i)) / Δ.b ν₀ j ≤ K
      rw [hK]
      apply div_le_div_of_nonneg_right _ hν₀.le
      rw [Finset.sum_neg_distrib] at hsum
      linarith
    linarith
  rcases h with hyR | huR
  · exfalso
    have hpos : 0 < R' := by linarith
    obtain ⟨i, hi⟩ : ∃ i, R' ≤ ‖y i‖ := by
      by_contra hcon
      push_neg at hcon
      have := (pi_norm_lt_iff hpos).mpr hcon
      linarith
    rw [Real.norm_eq_abs] at hi
    linarith [hyi i]
  · have hu2 : R' ^ 2 ≤ ‖u‖ ^ 2 := pow_le_pow_left₀ (by linarith) huR 2
    have hu3 : ‖u‖ ^ 2 ≤ radialArea u := norm_le_of_radialArea (u := u)
    have hAK : K' < radialArea u := by nlinarith
    simp only [liftFamily]
    rw [hB _ _ _ ?_, mul_zero]
    rw [RealiseGen.planeArea_smul_inv_sqrt hl]
    have hpa : RealiseGen.planeArea u = radialArea u := rfl
    rw [hpa]
    have h1 : radialArea u / K' ≤ radialArea u / RealiseGen.softLen Δ F j e y :=
      div_le_div_of_nonneg_left (by linarith) hl hlK
    have h2 : 1 < radialArea u / K' := (one_lt_div (by linarith)).mpr hAK
    linarith

/-- Outer-face collars (S-lem:plc-faces (b)), `c_j = (1 − r_B) η₀ min_ν b_{νj} / 2`. -/
theorem liftFamily_collar (hΔ : Δ.Spec) (hF : F ≠ []) (he : 0 < e) :
    ∃ c > 0, ∀ ν, 0 < Δ.b ν j → ∀ y t u, y j = 0 →
      Δ.ℓ ν - c < ∑ i, Δ.b ν i * Function.update y j (radialArea u) i →
        liftFamily Δ F j e y t u = 0 := by
  obtain ⟨rB, hrB1, hB⟩ := (RealiseGen.planarGen_spec hΔ hF j he).support
  obtain ⟨c0, hc0, hc0le⟩ : ∃ c0 > 0, ∀ ν, 0 < Δ.b ν j → c0 ≤ Δ.b ν j := by
    obtain ⟨ν₀, hν₀⟩ := hΔ.bounded_dir j
    have hne : (Finset.univ.filter fun ν => 0 < Δ.b ν j).Nonempty := ⟨ν₀, by simp [hν₀]⟩
    refine ⟨(Finset.univ.filter fun ν => 0 < Δ.b ν j).inf' hne (fun ν => Δ.b ν j), ?_,
      fun ν hν => Finset.inf'_le _ (by simp [hν])⟩
    rw [gt_iff_lt, Finset.lt_inf'_iff]
    intro ν hν
    simpa using hν
  have hr0 : 0 ≤ max rB 0 := le_max_right _ _
  have hr1 : max rB 0 < 1 := max_lt hrB1 one_pos
  have hη := RealiseGen.eta0_pos F j he
  -- the arithmetic core
  have arith : ∀ (r l L A b c0 η ℓν S : ℝ), 0 ≤ r → r < 1 → 0 < l → l ≤ L → η < L → 0 < b →
      c0 ≤ b → 0 < η → ℓν - (1 - r) * η * c0 < b * A + S → L * b = ℓν - S → r * l < A := by
    intro r l L A b c0 η ℓν S hr0 hr1 hl hlL hηL hb hcb hη h hface
    by_contra hcon
    push_neg at hcon
    have h1 : r * l ≤ r * L := mul_le_mul_of_nonneg_left hlL hr0
    have h1' : A * b ≤ r * L * b := by nlinarith
    have h4 : (1 - r) * η * c0 ≤ (1 - r) * η * b :=
      mul_le_mul_of_nonneg_left hcb (by nlinarith)
    have h5 : 0 < (1 - r) * (L - η) * b := by
      have : 0 < 1 - r := by linarith
      have : 0 < L - η := by linarith
      positivity
    nlinarith
  refine ⟨(1 - max rB 0) * RealiseGen.eta0 F j e * c0, ?_, ?_⟩
  · have : 0 < 1 - max rB 0 := by linarith
    positivity
  intro ν hν y t u hy h
  by_cases hc : RealiseGen.cut Δ F j e y = 0
  · simp [liftFamily, hc]
  obtain ⟨-, hl⟩ :=
    RealiseGen.expSum_pos_softLen_pos hΔ he (RealiseGen.mem_goodParams_of_cut_ne he hc)
  have hL := RealiseGen.faceLen_of_lenCut_ne he (RealiseGen.cut_ne_zero hc).2 hν
  have hlL := RealiseGen.softLen_le_faceLen (F := F) he hν y
  have hδ := RealiseGen.softShift_pos F j he
  have key : ∑ i, Δ.b ν i * Function.update y j (radialArea u) i =
      Δ.b ν j * radialArea u + ∑ i, (if i = j then 0 else Δ.b ν i * y i) := by
    have : ∀ i, Δ.b ν i * Function.update y j (radialArea u) i =
        (if i = j then Δ.b ν j * radialArea u else 0) +
          (if i = j then 0 else Δ.b ν i * y i) := by
      intro i
      by_cases hi : i = j
      · subst hi; simp
      · simp [hi, Function.update_of_ne hi]
    rw [Finset.sum_congr rfl fun i _ => this i, Finset.sum_add_distrib]
    simp
  have hface : RealiseGen.faceLen Δ j ν y * Δ.b ν j =
      Δ.ℓ ν - ∑ i, (if i = j then 0 else Δ.b ν i * y i) := by
    show (Δ.ℓ ν - ∑ i, (if i = j then 0 else Δ.b ν i * y i)) / Δ.b ν j * Δ.b ν j = _
    field_simp
  rw [key] at h
  have hA := arith _ _ _ _ _ _ _ _ _ hr0 hr1 hl (by linarith) (by linarith) hν (hc0le ν hν) hη
    h hface
  simp only [liftFamily]
  rw [hB _ _ _ ?_, mul_zero]
  rw [RealiseGen.planeArea_smul_inv_sqrt hl, lt_div_iff₀ hl]
  have hpa : RealiseGen.planeArea u = radialArea u := rfl
  rw [hpa]
  have : rB * RealiseGen.softLen Δ F j e y ≤ max rB 0 * RealiseGen.softLen Δ F j e y :=
    mul_le_mul_of_nonneg_right (le_max_left _ _) hl.le
  linarith

/-- Invariance of the slice discs (S-thm:plc-lift (a)): the planar flow of the slice family is
`√ℓ · q_{y, χ(y) S(t)}(u/√ℓ)`, which fixes `{π|u|² ≥ r_B ℓ}` and `ℓ < L_j`. -/
theorem liftFamily_disc (hΔ : Δ.Spec) (hF : F ≠ []) (he : 0 < e) :
    ∀ p ∈ Δ.set, ∀ t u, radialArea u ≤ Δ.sliceLen j p →
      radialArea (planarFlow (liftFamily Δ F j e (sliceBase j p)) t u) ≤ Δ.sliceLen j p := by
  intro p hp t u hu
  have hsupp : ∃ R : ℝ, ∀ y t u, y j = 0 → (t ∉ Icc (0 : ℝ) 1 ∨ R ≤ ‖y‖ ∨ R ≤ ‖u‖) →
      liftFamily Δ F j e y t u = 0 := by
    obtain ⟨R, hR⟩ := liftFamily_spatial (j := j) hΔ hF he
    exact ⟨R, fun y t u hy h => h.elim (fun ht => liftFamily_time ht y u) (hR y t u hy)⟩
  have hy : sliceBase j p j = 0 := by simp [sliceBase]
  have hV := planarVF_csField (liftFamily_smooth hΔ hF he) hsupp (sliceBase j p) hy
  have hL0 : 0 ≤ Δ.sliceLen j p := le_trans (radialArea_nonneg u) hu
  -- a radial support level `ρ ≤ L_j(p)`
  obtain ⟨ρ, hρL, hρ⟩ : ∃ ρ, ρ ≤ Δ.sliceLen j p ∧
      ∀ s v, ρ < radialArea v → liftFamily Δ F j e (sliceBase j p) s v = 0 := by
    by_cases hc : RealiseGen.cut Δ F j e (sliceBase j p) = 0
    · exact ⟨0, hL0, fun s v _ => by simp [liftFamily, hc]⟩
    obtain ⟨rB, hrB1, hB⟩ := (RealiseGen.planarGen_spec hΔ hF j he).support
    obtain ⟨-, hl⟩ :=
      RealiseGen.expSum_pos_softLen_pos hΔ he (RealiseGen.mem_goodParams_of_cut_ne he hc)
    have hlL : RealiseGen.softLen Δ F j e (sliceBase j p) ≤ Δ.sliceLen j p := by
      obtain ⟨ν₀, hν₀⟩ := hΔ.bounded_dir j
      haveI : Nonempty {ν : Fin q // 0 < Δ.b ν j} := ⟨⟨ν₀, hν₀⟩⟩
      unfold Polytope.sliceLen
      refine le_ciInf fun ν => ?_
      have h1 := RealiseGen.softLen_le_faceLen (F := F) he ν.2 (sliceBase j p)
      have h2 : RealiseGen.faceLen Δ j ν.1 (sliceBase j p) =
          (Δ.ℓ ν - ∑ i, (if i = j then 0 else Δ.b ν i * p i)) / Δ.b ν j := by
        unfold RealiseGen.faceLen
        congr 2
        refine Finset.sum_congr rfl fun i _ => ?_
        by_cases hi : i = j
        · simp [hi]
        · simp [hi, sliceBase]
      linarith [RealiseGen.softShift_pos F j he]
    refine ⟨max rB 0 * RealiseGen.softLen Δ F j e (sliceBase j p), ?_, fun s v hv => ?_⟩
    · have : max rB 0 * RealiseGen.softLen Δ F j e (sliceBase j p) ≤
          1 * RealiseGen.softLen Δ F j e (sliceBase j p) :=
        mul_le_mul_of_nonneg_right (max_le hrB1.le zero_le_one) hl.le
      linarith
    · simp only [liftFamily]
      rw [hB _ _ _ ?_, mul_zero]
      rw [RealiseGen.planeArea_smul_inv_sqrt hl, lt_div_iff₀ hl]
      have hpa : RealiseGen.planeArea v = radialArea v := rfl
      rw [hpa]
      have : rB * RealiseGen.softLen Δ F j e (sliceBase j p) ≤
          max rB 0 * RealiseGen.softLen Δ F j e (sliceBase j p) :=
        mul_le_mul_of_nonneg_right (le_max_left _ _) hl.le
      linarith
  -- points outside the support level are fixed
  have hfix : ∀ v, ρ < radialArea v →
      planarFlow (liftFamily Δ F j e (sliceBase j p)) t v = v := by
    intro v hv
    show Return.flowFrom (planarVF (liftFamily Δ F j e (sliceBase j p))) 0 v t = v
    refine hV.flowFrom_eq (u := fun _ => v) ⟨rfl, fun s => ?_⟩ t
    have h0 : planarVF (liftFamily Δ F j e (sliceBase j p)) s v = 0 := by
      have : liftFamily Δ F j e (sliceBase j p) s =ᶠ[nhds v] fun _ => 0 := by
        filter_upwards [(isOpen_lt continuous_const contDiff_radialArea.continuous).mem_nhds hv]
          with w hw
        exact hρ s w hw
      simp [planarVF, this.fderiv_eq]
    rw [h0]
    exact hasDerivAt_const s v
  by_contra hcon
  push_neg at hcon
  have h1 := hfix _ (lt_of_le_of_lt hρL hcon)
  have h2 := hV.flow_injective t h1
  rw [h2] at hcon
  linarith

/-- The realisation estimate (S-thm:plc-lift (c)): the cases `L_j < 2η₀` (trivial bound) and
`L_j ≥ 2η₀` (`χ = 1`, `planarGen_spec` on the shortened slice, endpoint shift `L − ℓ ≤ ζ/2`). -/
theorem liftFamily_estimate (hΔ : Δ.Spec) (hF : F ≠ []) (he : 0 < e) :
    ∀ p ∈ Δ.set, ∀ u : ℝ × ℝ, radialArea u = p j →
      PolyFn.eval F (Function.update p j
          (radialArea (planarFlow (liftFamily Δ F j e (sliceBase j p)) 1 u))) ≤
        rearr Δ j (PolyFn.eval F) p + e :=
  fun _ hp _ hu => LiftEst.liftFamily_estimate_aux hΔ hF he hp hu

end liftFamily

/-- The slice family of `liftGen` satisfies `SliceFamilySpec`. -/
theorem liftFamily_spec {Δ : Polytope m q} (hΔ : Δ.Spec) {F : PolyFn m} (hF : F ≠ [])
    (j : Fin m) {e : ℝ} (he : 0 < e) : SliceFamilySpec Δ F j e (liftFamily Δ F j e) := by
  obtain ⟨R, hR⟩ := liftFamily_spatial (j := j) hΔ hF he
  refine ⟨liftFamily_smooth hΔ hF he, ⟨R, fun y t u hy h => ?_⟩, liftFamily_collar hΔ hF he,
    liftFamily_disc hΔ hF he, liftFamily_estimate hΔ hF he⟩
  rcases h with ht | h
  · exact liftFamily_time ht y u
  · exact hR y t u hy h

/-- **thm:cmp-realisation** for `RealiseGen.liftGen`, from `liftFamily_spec`. -/
theorem liftGen_spec {Δ : Polytope m q} (hΔ : Δ.Spec) {F : PolyFn m} (hF : F ≠ [])
    (j : Fin m) {e : ℝ} (he : 0 < e) :
    GenSpec (RealiseGen.liftGen Δ F j e) ∧ PreservesRegion Δ (RealiseGen.liftGen Δ F j e) ∧
      FaceCollar Δ (RealiseGen.liftGen Δ F j e) ∧
      ∀ w ∈ planeRegion Δ.b Δ.ℓ,
        PolyFn.eval F (planeMoments (isoOf (RealiseGen.liftGen Δ F j e) 1 w)) ≤
          rearr Δ j (PolyFn.eval F) (planeMoments w) + e := by
  rw [liftGen_eq]
  exact sliceLift_spec hΔ (liftFamily_spec hΔ hF j he)

end SymplecticPacking.HighDim
