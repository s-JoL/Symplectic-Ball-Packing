import SymplecticPacking.HighDim.Polytope
import SymplecticPacking.Return.Flow

/-!
# Hamiltonian isotopies of the fibre `ℂ^m` and their concatenation

The fibre is `PlanePhase (Fin m) = (ℝ²)^m` with the area form `phaseArea`. A generator
`Q : ℝ → (ℝ²)^m → ℝ` has the field `X_Q = (−∂_y Q, ∂_x Q)` in each plane (`ι_X ω = −dQ`, the
convention of the comparison datum, def:mech-datum); the isotopy is its flow (definite
description `Return.flow`). Concatenation uses flat clocks `χ_k(t) = s(Lt − k)` with
`s = Real.smoothTransition`, so that the stages run one after the other in `[0,1]`.
-/

noncomputable section

namespace SymplecticPacking.HighDim

open Set
open OAI.PackingSufficiencySupport.Hamiltonian (PlanePhase planeMoments phaseArea)
open OAI.PackingSufficiencySupport.MomentPolytope (Moments region planeRegion)
open scoped ContDiff

variable {m q : ℕ}

/-- The fibre `ℂ^m = (ℝ²)^m`. -/
abbrev Fibre (m : ℕ) := PlanePhase (Fin m)

/-- The Hamiltonian field of `Q` (convention `ι_X ω = −dQ`): `ẋ_j = −∂Q/∂y_j`, `ẏ_j = ∂Q/∂x_j`. -/
def fibreHamVF (Q : ℝ → Fibre m → ℝ) (t : ℝ) (w : Fibre m) : Fibre m := fun j =>
  (-(fderiv ℝ (Q t) w (Pi.single j (0, 1))), fderiv ℝ (Q t) w (Pi.single j (1, 0)))

/-- The isotopy generated by `Q`. -/
def isoOf (Q : ℝ → Fibre m → ℝ) (t : ℝ) (w : Fibre m) : Fibre m :=
  Return.flow (fibreHamVF Q) t w

/-- A generator: jointly smooth, supported in `[0,1] × (compact)`. -/
structure GenSpec (Q : ℝ → Fibre m → ℝ) : Prop where
  smooth : ContDiff ℝ ∞ (fun x : ℝ × Fibre m => Q x.1 x.2)
  support : ∃ R : ℝ, ∀ t w, (t ∉ Icc (0 : ℝ) 1 ∨ R ≤ ‖w‖) → Q t w = 0

/-- The isotopy preserves the polytope region `V_Δ = p⁻¹(Δ)`. -/
def PreservesRegion (Δ : Polytope m q) (Q : ℝ → Fibre m → ℝ) : Prop :=
  ∀ t w, w ∈ planeRegion Δ.b Δ.ℓ → isoOf Q t w ∈ planeRegion Δ.b Δ.ℓ

/-- Outer-face collars: on `{ℓ_ν − η < ⟨b_ν, p⟩}` the generator Poisson-commutes with the face
moment `⟨b_ν, p⟩`, for one `η > 0` independent of `t`. -/
def FaceCollar (Δ : Polytope m q) (Q : ℝ → Fibre m → ℝ) : Prop :=
  ∃ η > 0, ∀ ν t w, Δ.ℓ ν - η < ∑ j, Δ.b ν j * planeMoments w j →
    fderiv ℝ (fun w : Fibre m => ∑ j, Δ.b ν j * planeMoments w j) w (fibreHamVF Q t w) = 0

/-- Flat clock of stage `k` among `L`: `χ_k(t) = s(Lt − k)`. -/
def stageClock (L k : ℕ) (t : ℝ) : ℝ := Real.smoothTransition (L * t - k)

/-- Concatenation of the generators `Qs` (stage `0` first) with flat clocks:
`Q(t,w) = Σ_k χ_k'(t) Q_k(χ_k(t), w)`. -/
def concatGen (Qs : List (ℝ → Fibre m → ℝ)) (t : ℝ) (w : Fibre m) : ℝ :=
  ∑ k : Fin Qs.length,
    deriv (stageClock Qs.length k) t * (Qs.get k) (stageClock Qs.length k t) w

/-! ### Clocks, generator fields and stage-local formulas -/

theorem deriv_smoothTransition_eq_zero {x : ℝ} (hx : x ≤ 0 ∨ 1 ≤ x) :
    deriv Real.smoothTransition x = 0 := by
  have hc : Continuous (deriv Real.smoothTransition) :=
    (contDiff_infty_iff_deriv.mp (Real.smoothTransition.contDiff : ContDiff ℝ ∞ Real.smoothTransition)).2.continuous
  have hcl : IsClosed {x | deriv Real.smoothTransition x = 0} := isClosed_eq hc continuous_const
  rcases hx with hx | hx
  · have hsub : Iio (0 : ℝ) ⊆ {x | deriv Real.smoothTransition x = 0} := by
      intro y hy
      have : Real.smoothTransition =ᶠ[nhds y] fun _ => 0 := by
        filter_upwards [Iio_mem_nhds hy] with z hz
        exact Real.smoothTransition.zero_of_nonpos hz.le
      simp only [mem_ofPred_eq]
      rw [this.deriv_eq]; simp
    have := hcl.closure_subset_iff.mpr hsub
    rw [closure_Iio] at this
    exact this hx
  · have hsub : Ioi (1 : ℝ) ⊆ {x | deriv Real.smoothTransition x = 0} := by
      intro y hy
      have : Real.smoothTransition =ᶠ[nhds y] fun _ => 1 := by
        filter_upwards [Ioi_mem_nhds hy] with z hz
        exact Real.smoothTransition.one_of_one_le hz.le
      simp only [mem_ofPred_eq]
      rw [this.deriv_eq]; simp
    have := hcl.closure_subset_iff.mpr hsub
    rw [closure_Ioi] at this
    exact this hx

theorem stageClock_contDiff (L k : ℕ) : ContDiff ℝ ∞ (stageClock L k) :=
  Real.smoothTransition.contDiff.comp ((contDiff_const.mul contDiff_id).sub contDiff_const)

theorem stageClock_hasDerivAt (L k : ℕ) (t : ℝ) :
    HasDerivAt (stageClock L k) ((L : ℝ) * deriv Real.smoothTransition (L * t - k)) t := by
  have h1 : HasDerivAt (fun t : ℝ => (L : ℝ) * t - k) L t := by
    simpa using ((hasDerivAt_id t).const_mul (L : ℝ)).sub_const (k : ℝ)
  have hd : Differentiable ℝ Real.smoothTransition :=
    (Real.smoothTransition.contDiff : ContDiff ℝ ∞ Real.smoothTransition).differentiable (by simp)
  have := (hd ((L : ℝ) * t - k)).hasDerivAt.comp t h1
  rw [mul_comm] at this
  exact this

theorem deriv_stageClock_eq_zero {L k : ℕ} {t : ℝ} (h : (L : ℝ) * t ≤ k ∨ (k : ℝ) + 1 ≤ L * t) :
    deriv (stageClock L k) t = 0 := by
  rw [(stageClock_hasDerivAt L k t).deriv, deriv_smoothTransition_eq_zero, mul_zero]
  rcases h with h | h
  · left; linarith
  · right; linarith

theorem stageClock_eq_zero {L k : ℕ} {t : ℝ} (h : (L : ℝ) * t ≤ k) : stageClock L k t = 0 := by
  unfold stageClock; exact Real.smoothTransition.zero_of_nonpos (by linarith)

theorem stageClock_eq_one {L k : ℕ} {t : ℝ} (h : (k : ℝ) + 1 ≤ L * t) :
    stageClock L k t = 1 := by
  unfold stageClock; exact Real.smoothTransition.one_of_one_le (by linarith)

theorem GenSpec.differentiableAt {Q : ℝ → Fibre m → ℝ} (hQ : GenSpec Q) (t : ℝ) (w : Fibre m) :
    DifferentiableAt ℝ (Q t) w := by
  have : ContDiff ℝ ∞ (Q t) := hQ.smooth.comp (contDiff_const.prodMk contDiff_id)
  exact (this.differentiable (by simp)) w

theorem GenSpec.vf_smooth {Q : ℝ → Fibre m → ℝ} (hQ : GenSpec Q) :
    ContDiff ℝ ∞ (fun p : ℝ × Fibre m => fibreHamVF Q p.1 p.2) := by
  have hf : ContDiff ℝ ∞ (Function.uncurry fun (p : ℝ × Fibre m) (v : Fibre m) => Q p.1 v) :=
    hQ.smooth.comp ((contDiff_fst.comp contDiff_fst).prodMk contDiff_snd)
  have hD : ContDiff ℝ ∞ (fun p : ℝ × Fibre m => fderiv ℝ (Q p.1) p.2) :=
    ContDiff.fderiv (f := fun (p : ℝ × Fibre m) (v : Fibre m) => Q p.1 v) hf contDiff_snd
      (le_of_eq rfl)
  refine contDiff_pi.mpr fun j => ?_
  show ContDiff ℝ ∞ (fun p : ℝ × Fibre m =>
    ((-(fderiv ℝ (Q p.1) p.2 (Pi.single j (0, 1))), fderiv ℝ (Q p.1) p.2 (Pi.single j (1, 0))) :
      ℝ × ℝ))
  exact (hD.clm_apply contDiff_const).neg.prodMk (hD.clm_apply contDiff_const)

theorem fibreHamVF_eq_zero_of_fderiv {Q : ℝ → Fibre m → ℝ} {t : ℝ} {w : Fibre m}
    (h : fderiv ℝ (Q t) w = 0) : fibreHamVF Q t w = 0 := by
  ext j <;> simp [fibreHamVF, h]

theorem fibreHamVF_zero {Q : ℝ → Fibre m → ℝ} {t : ℝ} (h : Q t = fun _ => 0) (w : Fibre m) :
    fibreHamVF Q t w = 0 :=
  fibreHamVF_eq_zero_of_fderiv (by rw [h]; simp)

theorem fibreHamVF_const_mul {P Q : ℝ → Fibre m → ℝ} {t σ c : ℝ}
    (hP : P t = fun w => c * Q σ w) (hd : ∀ w, DifferentiableAt ℝ (Q σ) w) (w : Fibre m) :
    fibreHamVF P t w = c • fibreHamVF Q σ w := by
  have : fderiv ℝ (P t) w = c • fderiv ℝ (Q σ) w := by
    rw [hP]; exact fderiv_const_mul (hd w) c
  ext j <;> simp [fibreHamVF, this]

theorem GenSpec.csField {Q : ℝ → Fibre m → ℝ} (hQ : GenSpec Q) :
    Return.CSField (fibreHamVF Q) := by
  obtain ⟨R, hR⟩ := hQ.support
  refine ⟨hQ.vf_smooth, HasCompactSupport.intro
    (K := Icc (0 : ℝ) 1 ×ˢ Metric.closedBall (0 : Fibre m) R)
    (isCompact_Icc.prod (isCompact_closedBall 0 R)) ?_⟩
  rintro ⟨t, w⟩ hp
  simp only [mem_prod, Metric.mem_closedBall, dist_zero_right, not_and_or, not_le] at hp
  rcases hp with ht | hw
  · exact fibreHamVF_zero (funext fun v => hR t v (Or.inl ht)) w
  · apply fibreHamVF_eq_zero_of_fderiv
    have : Q t =ᶠ[nhds w] fun _ => 0 := by
      filter_upwards [(isOpen_lt continuous_const continuous_norm).mem_nhds hw] with v hv
      exact hR t v (Or.inr (le_of_lt hv))
    rw [this.fderiv_eq]; simp

theorem concatGen_stage {Qs : List (ℝ → Fibre m → ℝ)} (k : Fin Qs.length) {t : ℝ}
    (ht : ((k : ℕ) : ℝ) ≤ Qs.length * t ∧ (Qs.length : ℝ) * t ≤ (k : ℕ) + 1) :
    concatGen Qs t = fun w =>
      deriv (stageClock Qs.length k) t * (Qs.get k) (stageClock Qs.length k t) w := by
  funext w
  unfold concatGen
  rw [Finset.sum_eq_single k]
  · intro j _ hj
    rw [deriv_stageClock_eq_zero, zero_mul]
    rcases lt_or_gt_of_ne hj with hlt | hgt
    · right
      have h1 : (j : ℕ) + 1 ≤ (k : ℕ) := hlt
      have : ((j : ℕ) : ℝ) + 1 ≤ ((k : ℕ) : ℝ) := by exact_mod_cast h1
      linarith
    · left
      have h1 : (k : ℕ) + 1 ≤ (j : ℕ) := hgt
      have : ((k : ℕ) : ℝ) + 1 ≤ ((j : ℕ) : ℝ) := by exact_mod_cast h1
      linarith
  · intro hk; exact absurd (Finset.mem_univ k) hk

theorem concatGen_eq_zero {Qs : List (ℝ → Fibre m → ℝ)} {t : ℝ} (ht : t ≤ 0 ∨ 1 ≤ t) :
    concatGen Qs t = fun _ => 0 := by
  funext w
  unfold concatGen
  refine Finset.sum_eq_zero fun k _ => ?_
  rw [deriv_stageClock_eq_zero, zero_mul]
  have hk : (k : ℕ) + 1 ≤ Qs.length := k.isLt
  have hk' : ((k : ℕ) : ℝ) + 1 ≤ Qs.length := by exact_mod_cast hk
  have h0 : (0 : ℝ) ≤ (k : ℕ) := Nat.cast_nonneg _
  have hL : (0 : ℝ) ≤ Qs.length := Nat.cast_nonneg _
  rcases ht with ht | ht
  · left; nlinarith
  · right; nlinarith

theorem concatGen_spec {Qs : List (ℝ → Fibre m → ℝ)} (h : ∀ Q ∈ Qs, GenSpec Q) :
    GenSpec (concatGen Qs) := by
  have hk : ∀ k : Fin Qs.length, GenSpec (Qs.get k) := fun k => h _ (List.get_mem Qs k)
  refine ⟨?_, ?_⟩
  · show ContDiff ℝ ∞ (fun x : ℝ × Fibre m => ∑ k : Fin Qs.length,
      deriv (stageClock Qs.length k) x.1 * (Qs.get k) (stageClock Qs.length k x.1) x.2)
    refine ContDiff.sum fun k _ => ?_
    exact (((contDiff_infty_iff_deriv.mp (stageClock_contDiff _ _)).2).comp contDiff_fst).mul
      ((hk k).smooth.comp (((stageClock_contDiff _ _).comp contDiff_fst).prodMk contDiff_snd))
  · choose R hR using fun k : Fin Qs.length => (hk k).support
    refine ⟨∑ k, max (R k) 0, fun t w hw => ?_⟩
    rcases hw with ht | hw
    · have : t ≤ 0 ∨ 1 ≤ t := by
        simp only [mem_Icc, not_and_or, not_le] at ht
        rcases ht with ht | ht
        · left; linarith
        · right; linarith
      rw [concatGen_eq_zero this]
    · unfold concatGen
      refine Finset.sum_eq_zero fun k _ => ?_
      rw [hR k _ _ (Or.inr ?_), mul_zero]
      calc R k ≤ max (R k) 0 := le_max_left _ _
        _ ≤ ∑ j, max (R j) 0 :=
          Finset.single_le_sum (f := fun j => max (R j) 0) (fun j _ => le_max_right _ _)
            (Finset.mem_univ k)
        _ ≤ ‖w‖ := hw

/-! ### Flows of the concatenation -/

/-- Where a generator vanishes on `[a, b)`, its isotopy is constant on `[a, b]`. -/
theorem isoOf_const_of_zero {Q : ℝ → Fibre m → ℝ} (hQ : GenSpec Q) {a b : ℝ} (hab : a ≤ b)
    (hz : ∀ x ∈ Ico a b, Q x = fun _ => 0) (w : Fibre m) : isoOf Q b w = isoOf Q a w := by
  have hV := hQ.csField
  have hd : ∀ x, HasDerivAt (fun s => isoOf Q s w) (fibreHamVF Q x (isoOf Q x w)) x :=
    fun x => hV.flow_hasDerivAt w x
  exact constant_of_has_deriv_right_zero (f := fun s => isoOf Q s w) (a := a) (b := b)
    (fun x _ => (hd x).continuousAt.continuousWithinAt)
    (fun x hx => by
      have h0 : fibreHamVF Q x (isoOf Q x w) = 0 := fibreHamVF_zero (hz x hx) _
      rw [← h0]; exact (hd x).hasDerivWithinAt) b ⟨hab, le_rfl⟩

theorem isoOf_zero {Q : ℝ → Fibre m → ℝ} (hQ : GenSpec Q) (w : Fibre m) : isoOf Q 0 w = w :=
  hQ.csField.flow_zero w

/-- On stage `k` the concatenated isotopy runs the `k`-th isotopy at its clock time,
starting from the node `k / L`. -/
theorem isoOf_concatGen_stage {Qs : List (ℝ → Fibre m → ℝ)} (h : ∀ Q ∈ Qs, GenSpec Q)
    (w : Fibre m) (k : Fin Qs.length) {t : ℝ}
    (ht : ((k : ℕ) : ℝ) ≤ Qs.length * t ∧ (Qs.length : ℝ) * t ≤ (k : ℕ) + 1) :
    isoOf (concatGen Qs) t w = isoOf (Qs.get k) (stageClock Qs.length k t)
      (isoOf (concatGen Qs) (((k : ℕ) : ℝ) / Qs.length) w) := by
  have hLpos : (0 : ℝ) < Qs.length := by exact_mod_cast Nat.zero_lt_of_lt k.isLt
  have hne : (Qs.length : ℝ) ≠ 0 := hLpos.ne'
  have hQ : GenSpec (Qs.get k) := h _ (List.get_mem Qs k)
  have hV := (concatGen_spec h).csField
  have hVk := hQ.csField
  set a : ℝ := ((k : ℕ) : ℝ) / Qs.length with ha
  have hLa : (Qs.length : ℝ) * a = (k : ℕ) := by rw [ha]; field_simp
  have hat : a ≤ t := le_of_mul_le_mul_left (by rw [hLa]; exact ht.1) hLpos
  have hstage : ∀ σ ∈ Icc a t,
      ((k : ℕ) : ℝ) ≤ Qs.length * σ ∧ (Qs.length : ℝ) * σ ≤ (k : ℕ) + 1 := by
    intro σ hσ
    constructor
    · have := mul_le_mul_of_nonneg_left hσ.1 hLpos.le; linarith
    · have := mul_le_mul_of_nonneg_left hσ.2 hLpos.le; linarith
  have hF : ∀ σ, HasDerivAt (fun s => isoOf (concatGen Qs) s w)
      (fibreHamVF (concatGen Qs) σ (isoOf (concatGen Qs) σ w)) σ :=
    fun σ => hV.flow_hasDerivAt w σ
  have hG : ∀ σ, HasDerivAt
      (fun s => isoOf (Qs.get k) (stageClock Qs.length k s) (isoOf (concatGen Qs) a w))
      (deriv (stageClock Qs.length k) σ • fibreHamVF (Qs.get k) (stageClock Qs.length k σ)
        (isoOf (Qs.get k) (stageClock Qs.length k σ) (isoOf (concatGen Qs) a w))) σ :=
    fun σ => (hVk.flow_hasDerivAt (isoOf (concatGen Qs) a w) (stageClock Qs.length k σ)).scomp σ
      ((((stageClock_contDiff _ _).differentiable (by simp)) σ).hasDerivAt)
  obtain ⟨K, hK⟩ := hV.lipschitz_slice
  have heq := ODE_solution_unique_of_mem_Icc_right (v := fibreHamVF (concatGen Qs))
    (s := fun _ => univ) (K := K)
    (f := fun s => isoOf (concatGen Qs) s w)
    (g := fun s => isoOf (Qs.get k) (stageClock Qs.length k s) (isoOf (concatGen Qs) a w))
    (a := a) (b := t)
    (fun σ _ => (hK σ).lipschitzOnWith)
    (fun σ _ => (hF σ).continuousAt.continuousWithinAt)
    (fun σ _ => (hF σ).hasDerivWithinAt)
    (fun _ _ => mem_univ _)
    (fun σ _ => (hG σ).continuousAt.continuousWithinAt)
    (fun σ hσ => by
      rw [fibreHamVF_const_mul (concatGen_stage k (hstage σ (Ico_subset_Icc_self hσ)))
        (fun v => hQ.differentiableAt _ v)]
      exact (hG σ).hasDerivWithinAt)
    (fun _ _ => mem_univ _)
    (by
      show isoOf (concatGen Qs) a w =
        isoOf (Qs.get k) (stageClock Qs.length k a) (isoOf (concatGen Qs) a w)
      rw [stageClock_eq_zero hLa.le, isoOf_zero hQ])
  exact heq ⟨hat, le_rfl⟩

/-- At the node `k / L` the concatenated isotopy is the composition of the first `k` stages. -/
theorem isoOf_concatGen_node {Qs : List (ℝ → Fibre m → ℝ)} (h : ∀ Q ∈ Qs, GenSpec Q)
    (hpos : 0 < Qs.length) (w : Fibre m) (k : ℕ) (hk : k ≤ Qs.length) :
    isoOf (concatGen Qs) ((k : ℝ) / Qs.length) w =
      (Qs.take k).foldl (fun x Q => isoOf Q 1 x) w := by
  induction k with
  | zero =>
    simp only [Nat.cast_zero, zero_div, List.take_zero, List.foldl_nil]
    exact isoOf_zero (concatGen_spec h) w
  | succ k ih =>
    have hkL : k < Qs.length := hk
    have hLpos : (0 : ℝ) < Qs.length := by exact_mod_cast hpos
    have hne : (Qs.length : ℝ) ≠ 0 := hLpos.ne'
    have e : (Qs.length : ℝ) * (((k : ℝ) + 1) / Qs.length) = k + 1 := by field_simp
    have hst := isoOf_concatGen_stage h w ⟨k, hkL⟩ (t := ((k : ℝ) + 1) / Qs.length)
      (by simp only [e]; constructor <;> linarith)
    have hone : stageClock Qs.length k (((k : ℝ) + 1) / Qs.length) = 1 :=
      stageClock_eq_one (by rw [e])
    rw [Nat.cast_succ, ← List.take_concat_get' Qs k hkL, List.foldl_append, List.foldl_cons,
      List.foldl_nil, ← ih hkL.le, hst]
    simp only [hone, List.get_eq_getElem]

/-- The time-one map of the concatenation is the composition of the time-one maps
(stage `0` applied first). -/
theorem isoOf_concatGen_one {Qs : List (ℝ → Fibre m → ℝ)} (h : ∀ Q ∈ Qs, GenSpec Q)
    (w : Fibre m) :
    isoOf (concatGen Qs) 1 w = Qs.foldl (fun x Q => isoOf Q 1 x) w := by
  rcases Nat.eq_zero_or_pos Qs.length with hL | hpos
  · obtain rfl : Qs = [] := List.eq_nil_of_length_eq_zero hL
    rw [isoOf_const_of_zero (concatGen_spec h) zero_le_one
      (fun x _ => by funext v; simp [concatGen]) w, isoOf_zero (concatGen_spec h)]
    rfl
  · have := isoOf_concatGen_node h hpos w Qs.length le_rfl
    rwa [div_self (Nat.cast_ne_zero.mpr hpos.ne'), List.take_length] at this

theorem exists_stage {L : ℕ} (hL : 0 < L) {t : ℝ} (h0 : 0 ≤ t) (h1 : t ≤ 1) :
    ∃ k : Fin L, ((k : ℕ) : ℝ) ≤ L * t ∧ (L : ℝ) * t ≤ (k : ℕ) + 1 := by
  have hLr : (0 : ℝ) < L := by exact_mod_cast hL
  by_cases ht : t < 1
  · have hlt : (L : ℝ) * t < L := by nlinarith
    refine ⟨⟨⌊(L : ℝ) * t⌋₊, ?_⟩, Nat.floor_le (by positivity), (Nat.lt_floor_add_one _).le⟩
    exact (Nat.floor_lt (by positivity)).mpr hlt
  · have : t = 1 := le_antisymm h1 (not_lt.mp ht)
    subst this
    have hc : ((L - 1 : ℕ) : ℝ) = (L : ℝ) - 1 := by
      rw [Nat.cast_sub (by omega)]; simp
    refine ⟨⟨L - 1, by omega⟩, ?_, ?_⟩ <;> simp only [hc] <;> linarith

theorem foldl_mem_region {Δ : Polytope m q} (l : List (ℝ → Fibre m → ℝ))
    (hl : ∀ Q ∈ l, PreservesRegion Δ Q) :
    ∀ x ∈ planeRegion Δ.b Δ.ℓ, l.foldl (fun x Q => isoOf Q 1 x) x ∈ planeRegion Δ.b Δ.ℓ := by
  induction l with
  | nil => intro x hx; simpa using hx
  | cons Q l ih =>
    intro x hx
    simp only [List.foldl_cons]
    exact ih (fun Q' hQ' => hl Q' (List.mem_cons_of_mem _ hQ')) _
      (hl Q List.mem_cons_self 1 x hx)

theorem concatGen_preserves {Δ : Polytope m q} {Qs : List (ℝ → Fibre m → ℝ)}
    (h : ∀ Q ∈ Qs, GenSpec Q) (hp : ∀ Q ∈ Qs, PreservesRegion Δ Q) :
    PreservesRegion Δ (concatGen Qs) := by
  intro t w hw
  have hs := concatGen_spec h
  rcases le_or_gt t 0 with ht0 | ht0
  · rw [← isoOf_const_of_zero hs ht0
      (fun x hx => concatGen_eq_zero (Or.inl hx.2.le)) w, isoOf_zero hs]
    exact hw
  rcases le_or_gt 1 t with ht1 | ht1
  · rw [isoOf_const_of_zero hs ht1 (fun x hx => concatGen_eq_zero (Or.inr hx.1)) w,
      isoOf_concatGen_one h]
    exact foldl_mem_region Qs hp w hw
  rcases Nat.eq_zero_or_pos Qs.length with hL | hpos
  · obtain rfl : Qs = [] := List.eq_nil_of_length_eq_zero hL
    rw [isoOf_const_of_zero hs ht0.le (fun x _ => by funext v; simp [concatGen]) w,
      isoOf_zero hs]
    exact hw
  obtain ⟨k, hk⟩ := exists_stage hpos ht0.le ht1.le
  rw [isoOf_concatGen_stage h w k hk, isoOf_concatGen_node h hpos w k k.isLt.le]
  exact hp _ (List.get_mem Qs k) _ _
    (foldl_mem_region _ (fun Q hQ => hp Q (List.mem_of_mem_take hQ)) w hw)

theorem concatGen_collar {Δ : Polytope m q} {Qs : List (ℝ → Fibre m → ℝ)}
    (h : ∀ Q ∈ Qs, GenSpec Q) (hc : ∀ Q ∈ Qs, FaceCollar Δ Q) :
    FaceCollar Δ (concatGen Qs) := by
  rcases Nat.eq_zero_or_pos Qs.length with hL | hpos
  · obtain rfl : Qs = [] := List.eq_nil_of_length_eq_zero hL
    refine ⟨1, one_pos, fun ν t w _ => ?_⟩
    rw [fibreHamVF_zero (Q := concatGen []) (t := t) (funext fun v => by simp [concatGen]) w,
      map_zero]
  have hk : ∀ k : Fin Qs.length, FaceCollar Δ (Qs.get k) := fun k => hc _ (List.get_mem Qs k)
  choose η hη hηc using hk
  have hne : (Finset.univ : Finset (Fin Qs.length)).Nonempty := ⟨⟨0, hpos⟩, Finset.mem_univ _⟩
  refine ⟨Finset.univ.inf' hne η, (Finset.lt_inf'_iff _).mpr fun k _ => hη k,
    fun ν t w hw => ?_⟩
  by_cases ht : t ≤ 0 ∨ 1 ≤ t
  · rw [fibreHamVF_zero (concatGen_eq_zero ht) w, map_zero]
  simp only [not_or, not_le] at ht
  obtain ⟨k, hk⟩ := exists_stage hpos ht.1.le ht.2.le
  have hle : Finset.univ.inf' hne η ≤ η k := Finset.inf'_le η (Finset.mem_univ k)
  have hQ : GenSpec (Qs.get k) := h _ (List.get_mem Qs k)
  rw [fibreHamVF_const_mul (concatGen_stage k hk) (fun v => hQ.differentiableAt _ v) w, map_smul,
    hηc k ν _ w (by linarith), smul_zero]

end SymplecticPacking.HighDim
