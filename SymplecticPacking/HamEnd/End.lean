import SymplecticPacking.General.Interface
import SymplecticPacking.General.Ham.Isotopy.Radii
import SymplecticPacking.General.Ham.StageB

/-!
# The Hamiltonian end (dimension-free)

From enlarged-source symplectic embeddings into the target and pairwise disjoint source balls
to one explicit Hamiltonian: common isotopy (translations, linear symplectic paths, relative
shape, common tail), radial primitive, cut-off, in every dimension `2n`.
`hamiltonianOfEmbeddings` and its specification `hamiltonian_end` are the interface used by
`SymplecticPacking.General.Main`.
-/

noncomputable section

namespace SymplecticPacking.HamEnd

open Metric Set Problem General
open SymplecticPacking.General.Ham SymplecticPacking.General.Ham.Isotopy

/-- The explicit Hamiltonian generated by the common isotopy from the translations
`u ↦ s_i + u` to the embeddings `D.f i`, on the source balls of capacities `c_i`. -/
def hamiltonianOfEmbeddings (n k : ℕ) (c : Fin k → ℝ) (s : Fin k → E n)
    (D : EmbeddingData n k) : ℝ → E n → ℝ :=
  ofIsotopy (isoF D.f s (rad c s D 3)) (rad c s D 1) (rad c s D 2) (rad c s D 3)

/-- **Hamiltonian end.** Explicit enlarged-source embeddings into `B°(C)` and pairwise disjoint
closed source balls `s_i + B(c_i)` give a Hamiltonian satisfying the packing specification. -/
theorem hamiltonian_end {n k : ℕ} {C : ℝ} {c : Fin k → ℝ} {s : Fin k → E n}
    {D : EmbeddingData n k} (hn : 1 ≤ n) (hc : ∀ i, 0 < c i) (hs : BallsDisjoint n k c s)
    (hD : EmbeddingSpec n k C c D) :
    PackingSpec n k C c s (hamiltonianOfEmbeddings n k c s D) := by
  have hI := isoInput hn hc hs hD
  obtain ⟨hF, hend⟩ := hI.commonIsotopy
  obtain ⟨hsm, hcs, hex, hflow⟩ := ofIsotopy_spec hF
  refine ⟨hsm, hcs, fun i x _ => hex x, fun i x hx γ hγ0 hγ => ?_⟩
  set u := x - s i
  have hu : ‖u‖ ≤ capRadius (c i) := (mem_capBall_iff (hc i).le).mp hx
  have hu1 : ‖u‖ < rad c s D 1 i := hu.trans_lt (source_lt_rad_one hc hs hD i)
  have hγ1 := hflow i u hu1 γ (by rw [hγ0]; simp [u]) hγ 1 ⟨zero_le_one, le_rfl⟩
  have hu4 : u ∈ ball (0 : E n) (rad c s D 4 i) := mem_ball_zero_iff.mpr
    (hu1.trans (hI.radii i).2.1 |>.trans (hI.radii i).2.2.1 |>.trans (hI.radii i).2.2.2.1)
  rw [hγ1, hend i u hu4]
  have hue : u ∈ capBall (0 : E n) (D.enlarged i) := by
    rw [capBall_zero_eq ((hc i).trans (hD.lt_enlarged i)).le, mem_closedBall_zero_iff]
    exact hu.trans (capRadius_lt (hc i).le (hD.lt_enlarged i)).le
  exact hD.into i ⟨u, hue, rfl⟩

end SymplecticPacking.HamEnd
